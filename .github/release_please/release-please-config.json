{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "cream-extensions",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "cream-catalog.yaml" },
        { "type": "generic", "path": "README.md" },
        { "type": "generic", "path": "docs/getting-started.md" }
      ],
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "changelog-sections": [
        { "type": "feat", "section": "Добавлено" },
        { "type": "fix", "section": "Исправлено" },
        { "type": "perf", "section": "Производительность" },
        { "type": "revert", "section": "Отменено" }
      ]
    }
  }
}

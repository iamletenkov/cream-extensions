# Вариант L (make test-live EXT=existing-desktop DISTRO=ubuntu-24.04 ARGS='--variant sddm'):
# готовый SDDM (Kubuntu). Ночью: тянет Qt. Конфиги SDDM и /etc/X11 после remove — те же,
# что до cream. sddm в контейнере падает (нет VT и X) — не дефект расширения.
LIVE_PREINSTALL="sddm xserver-xorg-core"
LIVE_EXPECT_RESTORED="/etc/sddm.conf /etc/sddm.conf.d /etc/X11/xorg.conf /etc/X11/xorg.conf.d /etc/X11/Xsession.d /etc/X11/Xwrapper.config /etc/X11/default-display-manager"
LIVE_DISTROS="ubuntu-24.04"
LIVE_NIGHTLY_ONLY=1
LIVE_FAILED_IGNORE="^sddm\.service$"

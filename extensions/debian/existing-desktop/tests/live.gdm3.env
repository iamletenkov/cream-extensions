# Вариант L (make test-live EXT=existing-desktop DISTRO=ubuntu-24.04 ARGS='--variant gdm3'):
# готовый gdm3 вместо LightDM. gdm3 тянет gnome-shell — сотни МБ, поэтому только ночью.
# Файлы gdm3 и /etc/X11 после remove — те же, что до cream. gdm в контейнере падает.
LIVE_PREINSTALL="gdm3 xserver-xorg-core"
LIVE_EXPECT_RESTORED="/etc/gdm3 /etc/X11/xorg.conf /etc/X11/xorg.conf.d /etc/X11/Xsession.d /etc/X11/Xwrapper.config /etc/X11/default-display-manager"
LIVE_DISTROS="ubuntu-24.04"
LIVE_NIGHTLY_ONLY=1
# polkit (ProtectHostname без CAP_SYS_ADMIN) и tpm-udev.path (unit-start-limit-hit) в контейнере ubuntu-24.04 на раннере ubuntu-26.04 — стенд, не расширение.
LIVE_FAILED_IGNORE="^((gdm3?|low-memory-monitor|polkit|tpm-udev)\.service|tpm-udev\.path)$"

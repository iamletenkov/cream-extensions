# Живой прогон tools/live-test.sh (make test-live EXT=existing-desktop): данные, не скрипт.
# Стол, поставленный не через cream: Xorg и LightDM — apt до cream (LIVE_PREINSTALL),
# X-сессия — файлом (tests/live-root/usr/share/xsessions). install только проверяет
# и ставит x11-xserver-utils (xhost, П15); remove ничего не трогает — /etc/lightdm и
# конфигурация X11 (xorg.conf*, Xsession.d, Xwrapper.config, default-display-manager) после
# remove та же, что до cream; /etc/X11/app-defaults не сверяется — x11-xserver-utils
# остаётся. Экрана в контейнере нет: lightdm падает (нет VT и X) — не дефект расширения.
# Варианты: live.gdm3.env, live.sddm.env,
# live.from-gnome.env (ночь, ubuntu-24.04).
LIVE_PREINSTALL="xserver-xorg-core lightdm"
LIVE_PRESEED=live-root
LIVE_EXPECT_RESTORED="/etc/lightdm /etc/X11/xorg.conf /etc/X11/xorg.conf.d /etc/X11/Xsession.d /etc/X11/Xwrapper.config /etc/X11/default-display-manager"
LIVE_DISTROS="debian-12 ubuntu-24.04"
LIVE_FAILED_IGNORE="^lightdm\.service$"

#!/usr/bin/env bash
# cream hook `remove` of docker: removes the packages `install` put on (the
# record in $CREAM_STATE_DIR/packages; a Docker that was there before cream
# stays), then the Docker source and key (only those the record
# $CREAM_STATE_DIR/apt-source calls ours; no record — both, as 4.1.x) and our
# NVIDIA source and key, and refreshes the apt lists. cream itself takes away
# the `files` (iptables-raw check and drop-in) and cream-configure@docker.
#
# apt-get remove, not purge: /var/lib/docker (images, volumes) and
# /etc/docker/daemon.json stay. What is NOT undone, on purpose: the competing
# packages install took away (docker.io & co.) are not put back; group docker
# membership and cgroup_enable=memory in the Pi cmdline.txt stay (harmless
# without docker). apt is asked first in simulation (library apt-guard): when it
# would take anything besides our packages the hook refuses and changes nothing.
# A repeat finds nothing and exits 0.
set -euo pipefail

log_info(){ >&2 echo "[INFO] docker: $*"; }
log_error(){ >&2 echo "[ERROR] docker: $*"; }

R="${CREAM_ROOT:-}"; R="${R%/}"
STATE="${CREAM_STATE_DIR:?run by cream}"

export DEBIAN_FRONTEND=noninteractive
ours=()
if [[ -f "$STATE/packages" ]]; then
    mapfile -t ours < <(sed '/^$/d' "$STATE/packages")
fi
if (( ${#ours[@]} )); then
    APT_GUARD="$R/opt/cream/ext/apt-guard/apt-guard.sh"
    [[ -f "$APT_GUARD" ]] || { log_error "нет библиотеки apt-guard ($APT_GUARD) — cream ставит её по depends"; exit 1; }
    # shellcheck source=../../apt-guard/apt-guard.sh
    source "$APT_GUARD"
    apt_guard_remove remove "${ours[@]}" || exit 1
    log_info "удалены: ${ours[*]} (данные /var/lib/docker и /etc/docker оставлены)"
else
    log_info "своих пакетов нет — Docker не трогаю"
fi

# The Docker source and key: only those the record (install 4.2.0+) calls ours;
# no record (installed by 4.1.x) — both, as 4.1.x did. A record line naming
# anything but the two paths is ignored. The NVIDIA source and key are ours by
# name (the vendor's is nvidia-l4t-apt-source.list) and always go.
DOCKER_FILES=(/etc/apt/sources.list.d/docker.sources /etc/apt/keyrings/docker.asc)
drop=()
if [[ -f "$STATE/apt-source" ]]; then
    while read -r owner path _; do
        [[ " ${DOCKER_FILES[*]} " == *" $path "* ]] || continue
        if [[ "$owner" == ours ]]; then
            drop+=("$path")
        else
            log_info "$path был до cream — не снимаю"
        fi
    done < "$STATE/apt-source"
else
    drop=("${DOCKER_FILES[@]}")
fi
drop+=(/etc/apt/sources.list.d/nvidia-jetson.sources /etc/apt/keyrings/nvidia-jetson.asc)

had_source=""
for f in "${drop[@]}"; do
    [[ "$f" == *.sources && -e "$R$f" ]] && had_source=1
    rm -f -- "$R$f"
done
# Lists of the removed sources stay until the next update; refresh now.
if [[ -n "$had_source" ]]; then
    apt-get -q update || log_error "apt-get update после снятия источника не прошёл (не критично)"
fi
rm -f -- "$STATE/packages" "$STATE/daemon-json.sha256" "$STATE/apt-source"

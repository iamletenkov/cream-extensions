# Вариант L (make test-live EXT=desktop DISTRO=ubuntu-24.04 ARGS='--variant gdm3'): П6/П12
# на живой системе. /etc/gdm3/custom.conf пакета gdm3 Ubuntu 24.04, где владелец включил
# автологин (preseed, до cream); install с DESKTOP_AUTOLOGIN=0 записывает строки как были и
# выключает автологин; remove возвращает custom.conf побайтно (sha256, режим, владелец).
# Пакет gdm3 не ставится: desktop читает и правит только файл.
LIVE_PRESEED=live-root-gdm3
LIVE_PARAMS="DESKTOP_AUTOLOGIN=0"
LIVE_EXPECT_RESTORED="/etc/gdm3/custom.conf"
LIVE_DISTROS="ubuntu-24.04"

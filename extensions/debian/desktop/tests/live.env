# Живой прогон tools/live-test.sh (make test-live EXT=desktop): данные, не скрипт.
# Библиотека cloud-user — раньше (depends). Менеджера входа в контейнере нет:
# configure обязан вернуть 0 и разложить файлы dconf и X; пользователя тоже нет —
# автологин не включается (предупреждение), на загрузке configure ждёт его 30 с.
# Сеть — apt дистрибутива (dconf-cli, x11-xserver-utils).
LIVE_DEPS=cloud-user
LIVE_PARAMS="DESKTOP_AUTOLOGIN=1 DESKTOP_DISABLE_SCREEN_LOCK=1 DESKTOP_DISABLE_SCREEN_BLANK=1"
LIVE_DISTROS="debian-12 ubuntu-24.04"

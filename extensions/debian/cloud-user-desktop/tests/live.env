# Живой прогон tools/live-test.sh (make test-live EXT=cloud-user-desktop): данные, не скрипт.
# Поверх xfce4 (вендорского стола в контейнере нет — его роль играет xfce4 с desktop
# и cloud-user, depends ставятся раньше); xfce4 — live: confirm, отсюда --accept-risk.
# Сеть — apt дистрибутива (Xfce4, lightdm — сотни мегабайт). Вендорской учётки в
# контейнере нет: install с пустым ключом ничего не удаляет; удаление, отказ на
# системной учётке и на занятой — H-тест. Проверяются установка без своей службы,
# повтор, --reinstall, загрузка (configure desktop до менеджера входа) и remove.
LIVE_DEPS="cloud-user desktop xfce4"
LIVE_ACCEPT_RISK=1
LIVE_MEMORY=2g
LIVE_DISTROS="debian-12"
# lightdm в контейнере падает (нет VT, X, logind) — не дефект расширения.
LIVE_FAILED_IGNORE="^lightdm\.service$"

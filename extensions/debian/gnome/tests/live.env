# Живой прогон tools/live-test.sh (make test-live EXT=gnome): данные, не скрипт.
# По плану (Task 13) — ночной прогон, в PR гоняется xfce4: apt GNOME — гигабайты.
# live: confirm — ставится с --accept-risk; desktop (и его cloud-user) — раньше
# (depends). Экрана в контейнере нет: gdm на загрузке падает (нет VT и X).
LIVE_DEPS="cloud-user desktop"
LIVE_ACCEPT_RISK=1
LIVE_MEMORY=2g
LIVE_DISTROS="debian-12"

#!/usr/bin/env bash
# cream hook `install` of gnome: GNOME on Xorg (Wayland off) with the gdm3
# display manager. Paths of the machine go under $CREAM_ROOT (hooktest).
#
# - installs GNOME, gdm3 and the X server; a browser is optional (chromium only);
# - WaylandEnable=false in [daemon] of the gdm3 config: x11vnc, xset and screen
#   capture (ximagesrc) work only in X11. Which file gdm reads is decided when
#   the PACKAGE is built (measured 2026-09-03): Debian — daemon.conf, Ubuntu —
#   custom.conf; a key in the other file is silently ignored. The hook edits the
#   key in every one the package put there and nothing else in them. Not cream
#   `files`: both are dpkg conffiles of gdm3 — laying them would make cream
#   refuse (conflict.file_unowned) on any machine that has gdm3 already, and gdm
#   has no drop-in directory;
# - the autologin, the screen lock and the blanking are the desktop extension
#   (depends), which edits the same gdm3 configs;
# - enables gdm and graphical.target. On a live machine either change takes
#   effect at the next boot: exit 10 (reboot required). The build phase exits 0.
#
# What was there before is kept in $CREAM_STATE_DIR (first record wins), so that
# `remove` puts back the default target and the display manager as they were.
set -euo pipefail

NAME=gnome

log_info(){ >&2 echo "[INFO] $NAME: $*"; }
log_warn(){ >&2 echo "[WARN] $NAME: $*"; }
log_error(){ >&2 echo "[ERROR] $NAME: $*"; }

R="${CREAM_ROOT:-}"; R="${R%/}"
STATE="${CREAM_STATE_DIR:?run by cream}"
SYSD="$R/etc/systemd/system"

apt_retry(){
    local i
    for i in 1 2 3; do
        "$@" && return 0
        log_warn "попытка $i: $* — не удалась, повтор через 10 с"
        sleep 10
    done
    return 1
}

# dm_current: the unit the display-manager.service alias points to, or nothing.
dm_current(){
    local l
    l="$(readlink "$SYSD/display-manager.service" 2>/dev/null)" || true
    printf '%s' "${l##*/}"
}
is_gdm(){ [[ "$1" == gdm.service || "$1" == gdm3.service ]]; }

default_current(){ systemctl get-default 2>/dev/null || true; }

# wayland_off <file>: WaylandEnable=false right after the [daemon] header; every
# other WaylandEnable line of that section (commented or not) goes, a missing
# section is appended. The rest of the file stays as the package wrote it; an
# unchanged file is not rewritten (a repeat finds the line in place).
wayland_off(){
    local file="$1" tmp
    tmp="$(mktemp "${file%/*}/.gdm.XXXXXX")" || return 1
    awk '
        function emit() { print "WaylandEnable=false"; done = 1 }
        /^[[:space:]]*\[/ {
            line = $0; sub(/^[[:space:]]*\[/, "", line); sub(/\].*$/, "", line)
            cur = line; print
            if (cur == "daemon" && !done) emit()
            next
        }
        cur == "daemon" && /^[[:space:]]*#*[[:space:]]*WaylandEnable[[:space:]]*=/ { next }
        { print }
        END { if (!done) { print ""; print "[daemon]"; emit() } }
    ' "$file" > "$tmp" || { rm -f -- "$tmp"; return 1; }
    if cmp -s "$tmp" "$file"; then
        rm -f -- "$tmp"
        return 0
    fi
    chmod --reference="$file" -- "$tmp" && mv -f -T -- "$tmp" "$file" \
        || { rm -f -- "$tmp"; return 1; }
}

# --- what was there before (first install only) --------------------------------
if [[ ! -s "$STATE/before" ]]; then
    install -d -m 0755 "$STATE"
    printf 'default=%s\ndm=%s\n' "$(default_current)" "$(dm_current)" > "$STATE/before"
fi
dm_before="$(dm_current)"
default_before="$(default_current)"

# --- packages ------------------------------------------------------------------
export DEBIAN_FRONTEND=noninteractive
APT_OPTS=(-q -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)
apt_retry apt-get -q update || { log_error "apt-get update не прошёл"; exit 1; }
apt_retry apt-get "${APT_OPTS[@]}" install \
    task-gnome-desktop \
    gdm3 gnome-shell gnome-session \
    xorg xinput x11-xserver-utils dconf-cli \
    usbutils dbus-x11 \
    || { log_error "GNOME и gdm3 не установились"; exit 1; }

# The browser is optional and native only. In Debian `chromium` is a plain deb.
# Ubuntu has no `chromium` (jammy, 2026-09-10: no installation candidate), and
# `chromium-browser` is a transitional package for the snap — NOT installed: it
# pulls snapd with all its units while the browser never arrives, because the
# postinst runs `snap install` and there is no running systemd in the build
# guest (measured 2026-09-12 on an AGX Orin image: snapd in the image, /snap
# empty). Neither gdm3, gnome-shell nor task-gnome-desktop depends on it.
# A browser on Ubuntu — epiphany-browser or falkon by a separate extension.
if apt-get "${APT_OPTS[@]}" install chromium >/dev/null 2>&1; then
    log_info "браузер: chromium"
else
    log_warn "браузера нет: нативного пакета chromium в этом дистрибутиве нет — сессия GNOME работает без него; переходник на snap не ставим"
fi

install -d -m 0755 "$R/etc/X11/xorg.conf.d"

# --- gdm: X11, not Wayland -----------------------------------------------------
edited=0
for conf in "$R/etc/gdm3/daemon.conf" "$R/etc/gdm3/custom.conf"; do
    if [[ -L "$conf" ]]; then
        log_warn "${conf#"$R"} — ссылка; по ней не пишу"
        continue
    fi
    [[ -f "$conf" ]] || continue
    wayland_off "$conf" || { log_error "не записался WaylandEnable=false в ${conf#"$R"}"; exit 1; }
    grep -qx 'WaylandEnable=false' "$conf" \
        || { log_error "WaylandEnable=false не нашёлся в ${conf#"$R"} после записи"; exit 1; }
    log_info "gdm: ${conf#"$R"} — Wayland выключен"
    edited=1
done
if [[ "$edited" != 1 ]]; then
    log_error "нет /etc/gdm3/daemon.conf и /etc/gdm3/custom.conf (обычными файлами) — Wayland останется включённым, x11vnc не заработает"
    exit 1
fi

# --- display manager and default target ----------------------------------------
# Debian 12+: gdm.service with the alias gdm3.service; enabling by an alias
# name is refused by newer systemd, hence gdm.service first.
reboot=0
current="$(dm_current)"
if [[ -n "$current" ]] && ! is_gdm "$current"; then
    log_warn "менеджер входа на машине — $current, не gdm; не перехватываю (systemctl enable --force gdm.service вручную)"
elif [[ -z "$current" ]]; then
    systemctl enable gdm.service || systemctl enable gdm3.service \
        || { log_error "gdm не включился"; exit 1; }
fi
[[ "$(dm_current)" == "$dm_before" ]] || reboot=1

if [[ "$default_before" != graphical.target ]]; then
    systemctl set-default graphical.target || { log_error "graphical.target не стал целью по умолчанию"; exit 1; }
    reboot=1
fi

if [[ "$reboot" == 1 && "${CREAM_PHASE:-}" == live ]]; then
    log_info "готово; экран входа gdm — после перезагрузки"
    exit 10
fi
log_info "готово"

#!/usr/bin/env bash
# cream hook `remove` of l4t-pytorch: takes away what `install` recorded in
# $CREAM_STATE_DIR —
#   pip         pip distributions it put into /usr/local; one another still
#               needs (numpy and scipy of l4t-tensorflow) stays (pip-owned.py);
#   packages    apt packages it put on; cuDNN and python3-pip stay while
#               tensorflow is installed in /usr/local;
#   cusparselt  /usr/local/cusparselt and its ld.so.conf entry;
#   openblas    the OPENBLAS_CORETYPE pin of R32: the services drop-in of this
#               extension, the /etc/environment line while no other drop-in
#               (l4t-opencv) carries the variable.
# apt is asked first in simulation: when it would take away anything besides
# our packages the hook refuses before changing anything. Things there before
# cream stay. A repeat finds nothing and exits 0.
set -euo pipefail

log_info(){ >&2 echo "[INFO] l4t-pytorch: $*"; }
log_warn(){ >&2 echo "[WARN] l4t-pytorch: $*"; }
log_error(){ >&2 echo "[ERROR] l4t-pytorch: $*"; }

R="${CREAM_ROOT:-}"; R="${R%/}"
STATE="${CREAM_STATE_DIR:?run by cream}"
EXT_DIR="${CREAM_EXT_DIR:?run by cream}"
SHARED=(libcudnn9-cuda-12 python3-pip)   # also what l4t-tensorflow runs on
OTHER=tensorflow

export DEBIAN_FRONTEND=noninteractive

lines(){ if [[ -f "$1" && ! -L "$1" ]]; then sed '/^$/d' "$1"; fi; }

# --- apt: what goes, checked before anything changes ---------------------------
ours=()
mapfile -t recorded < <(lines "$STATE/packages")
other_here=""
if (( ${#recorded[@]} )) && python3 "$EXT_DIR/pip-owned.py" has "$OTHER"; then
    other_here=1
fi
for p in "${recorded[@]}"; do
    keep=""
    if [[ -n "$other_here" ]]; then
        for s in "${SHARED[@]}"; do [[ "$p" == "$s" ]] && keep=1; done
    fi
    if [[ -n "$keep" ]]; then
        log_info "$p нужен $OTHER — остаётся"
    else
        ours+=("$p")
    fi
done
if (( ${#ours[@]} )); then
    sim="$(apt-get -s remove "${ours[@]}")" || { log_error "apt-get -s remove ${ours[*]} не прошёл"; exit 1; }
    extra=()
    while read -r verb pkg _; do
        [[ "$verb" == Remv ]] || continue
        mine=""
        for p in "${ours[@]}"; do [[ "$p" == "$pkg" ]] && mine=1; done
        [[ -n "$mine" ]] || extra+=("$pkg")
    done <<< "$sim"
    if (( ${#extra[@]} )); then
        log_error "вместе с ${ours[*]} apt снял бы и чужие пакеты: ${extra[*]}"
        log_error "сними руками или забудь запись: cream remove --forget l4t-pytorch"
        exit 1
    fi
fi

# --- pip ------------------------------------------------------------------------
if [[ -s "$STATE/pip" && ! -L "$STATE/pip" ]]; then
    mapfile -t go < <(python3 "$EXT_DIR/pip-owned.py" removable "$STATE/pip")
    if (( ${#go[@]} )); then
        install -d -m 0755 "$R/var/tmp"
        home="$(mktemp -d "$R/var/tmp/l4t-pytorch.XXXXXX")"
        # shellcheck disable=SC2064  # expand now: the path is fixed
        trap "rm -r -f -- '$home'" EXIT
        env HOME="$home" PIP_CONFIG_FILE=/dev/null PIP_NO_CACHE_DIR=1 PIP_USER=0 \
            PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONNOUSERSITE=1 \
            python3 -m pip uninstall -y "${go[@]}" || { log_error "pip uninstall ${go[*]} не прошёл"; exit 1; }
        log_info "pip: удалены ${go[*]}"
    fi
fi
rm -f -- "$STATE/pip"

# --- apt ------------------------------------------------------------------------
if (( ${#ours[@]} )); then
    apt-get -q -y remove "${ours[@]}" || { log_error "apt-get remove ${ours[*]} не прошёл"; exit 1; }
    log_info "apt: удалены ${ours[*]}"
fi
rm -f -- "$STATE/packages"

# --- cuSPARSELt -----------------------------------------------------------------
if [[ -e "$STATE/cusparselt" ]]; then
    rm -r -f -- "$R/usr/local/cusparselt"
    rm -f -- "$R/etc/ld.so.conf.d/cusparselt.conf"
    ldconfig || log_warn "ldconfig отработал с ошибкой"
    log_info "cuSPARSELt снят"
    rm -f -- "$STATE/cusparselt"
fi

# --- OPENBLAS_CORETYPE (R32) ------------------------------------------------------
if [[ -e "$STATE/openblas" ]]; then
    dropins="$R/etc/systemd/system.conf.d"
    rm -f -- "$dropins/l4t-pytorch.conf"
    still=""
    for f in "$dropins"/*.conf; do
        [[ -f "$f" ]] && grep -q 'OPENBLAS_CORETYPE=' "$f" && still=1
    done
    envf="$R/etc/environment"
    if [[ -n "$still" ]]; then
        log_info "OPENBLAS_CORETYPE нужен другому расширению — строка /etc/environment остаётся"
    elif [[ -L "$envf" ]]; then
        log_warn "/etc/environment — символическая ссылка: не трогаю"
    elif [[ -f "$envf" ]] && grep -qxF 'OPENBLAS_CORETYPE=ARMV8' "$envf"; then
        tmp="$(mktemp "$R/etc/.environment.XXXXXX")"
        grep -vxF 'OPENBLAS_CORETYPE=ARMV8' "$envf" > "$tmp" || true
        chmod 0644 "$tmp"
        mv -f -T -- "$tmp" "$envf"
        log_info "OPENBLAS_CORETYPE снят из /etc/environment"
    fi
    rm -f -- "$STATE/openblas"
fi

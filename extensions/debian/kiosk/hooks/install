#!/usr/bin/env bash
# cream hook `install` of kiosk: Chromium and the X client tools the wrapper
# needs (xdpyinfo is in x11-utils, not x11-xserver-utils — the old unit called
# it without installing it). Only the missing packages; those put on here are
# recorded in $CREAM_STATE_DIR/packages (the first record wins) so that
# `remove` takes away only its own. The unit template, the wrapper and the
# Xfce4 defaults are `files` — cream lays them out before this hook. Nothing
# is enabled here: configure enables the instance of the session user.
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log_info(){ >&2 echo -e "${GREEN}[INFO]${NC} kiosk: $*"; }
log_warn(){ >&2 echo -e "${YELLOW}[WARN]${NC} kiosk: $*"; }
log_error(){ >&2 echo -e "${RED}[ERROR]${NC} kiosk: $*"; }

STATE="${CREAM_STATE_DIR:?run by cream}/packages"
PACKAGES=(chromium x11-utils x11-xserver-utils xauth dbus-x11)

apt_retry(){
    local max=5 n=1 d
    while true; do
        if "$@"; then return 0; fi
        if (( n >= max )); then return 1; fi
        d=$(( n * 2 )); log_warn "apt не отработал, повтор через ${d}s ($n/$max)"
        sleep "$d"; n=$(( n + 1 ))
    done
}
is_installed(){ [[ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null || true)" == installed ]]; }

missing=()
for pkg in "${PACKAGES[@]}"; do
    is_installed "$pkg" || missing+=("$pkg")
done
if (( ${#missing[@]} == 0 )); then
    log_info "chromium и утилиты X уже стоят — apt не трогаю"
    exit 0
fi

export DEBIAN_FRONTEND=noninteractive
log_info "ставлю: ${missing[*]}"
apt_retry apt-get -q -y update || { log_error "apt-get update не прошёл"; exit 1; }
apt_retry apt-get -q -y install --no-install-recommends "${missing[@]}" \
    || { log_error "apt-get install ${missing[*]} не прошёл"; exit 1; }
if [[ ! -s "$STATE" ]]; then
    install -d -m 0755 "$(dirname "$STATE")"
    printf '%s\n' "${missing[@]}" > "$STATE"
fi
log_info "браузер установлен; экземпляр пользователя включит configure (стадия graphical)"

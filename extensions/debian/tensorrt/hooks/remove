#!/usr/bin/env bash
# cream hook `remove` of tensorrt: the packages `install` put on (the record in
# $CREAM_STATE_DIR/packages; packages that were there before cream stay). apt
# is asked first in simulation: when it would take away anything besides our
# packages (something installed later depends on them) the hook refuses and
# changes nothing. A repeat finds nothing and exits 0.
set -euo pipefail

log_info(){ >&2 echo "[INFO] tensorrt: $*"; }
log_error(){ >&2 echo "[ERROR] tensorrt: $*"; }

R="${CREAM_ROOT:-}"; R="${R%/}"
STATE="${CREAM_STATE_DIR:?run by cream}"

export DEBIAN_FRONTEND=noninteractive
ours=()
if [[ -f "$STATE/packages" && ! -L "$STATE/packages" ]]; then
    mapfile -t ours < <(sed '/^$/d' "$STATE/packages")
fi
if (( ${#ours[@]} )); then
    APT_GUARD="$R/opt/cream/ext/apt-guard/apt-guard.sh"
    [[ -f "$APT_GUARD" ]] || { log_error "нет библиотеки apt-guard ($APT_GUARD) — cream ставит её по depends"; exit 1; }
    # shellcheck source=../../apt-guard/apt-guard.sh
    source "$APT_GUARD"
    apt_guard_check remove "${ours[@]}" || exit 1
    apt-get -q -y remove "${ours[@]}" || { log_error "apt-get remove ${ours[*]} не прошёл"; exit 1; }
    log_info "удалены: ${ours[*]}"
else
    log_info "своих пакетов нет — TensorRT не трогаю"
fi

rm -f -- "$STATE/packages"

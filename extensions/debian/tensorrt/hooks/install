#!/usr/bin/env bash
# cream hook `install` of tensorrt: TensorRT from the NVIDIA jetson/common
# repository the L4T base image already connected (nvidia-l4t-apt-source); the
# source is discussed in cuda-toolkit/hooks/install, the same reasoning.
#
# WHY `tensorrt`, NOT `libnvinfer*` ONE BY ONE. `tensorrt` is a metapackage
# that pulls exactly a compatible runtime and dev headers of one version;
# assembling it by hand from a dozen names is how versions drift apart.
#
# WHY `python3-libnvinfer` TOO. Inference on a Jetson mostly runs from Python
# (ultralytics, deepstream glue, own scripts); `tensorrt` does not pull the
# bindings, they are a separate package apt does not take by itself.
#
# Branch: l4t_major of the library l4t (/etc/nv_tegra_release read as data).
# R32 (Jetson Nano) installs nothing and checks the engine of the base image.
#
# Exit codes (spec §6.2, ruling R11): 20 — not a Jetson (no
# /etc/nv_tegra_release), before apt touches anything; 1 — failure; 0 — done.
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log_info(){ >&2 echo -e "${GREEN}[INFO]${NC} tensorrt: $*"; }
log_warn(){ >&2 echo -e "${YELLOW}[WARN]${NC} tensorrt: $*"; }
log_error(){ >&2 echo -e "${RED}[ERROR]${NC} tensorrt: $*"; }

R="${CREAM_ROOT:-}"; R="${R%/}"
STATE="${CREAM_STATE_DIR:?run by cream}"

apt_retry(){
    local max=5 n=1 d
    while true; do
        if "$@"; then return 0; fi
        if (( n >= max )); then return 1; fi
        d=$(( n * 2 )); log_warn "apt не отработал, повтор через ${d}s ($n/$max)"
        sleep "$d"; n=$(( n + 1 ))
    done
}

# put_file MODE DEST: stdin into DEST through a temporary file in the same
# directory and a rename — a symlink at DEST is replaced, never followed.
put_file(){
    local mode="$1" dest="$2" tmp
    tmp="$(mktemp "$(dirname "$dest")/.tensorrt.XXXXXX")"
    cat > "$tmp"
    chmod "$mode" "$tmp"
    mv -f -T -- "$tmp" "$dest"
}

is_installed(){
    [[ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null || true)" == installed ]]
}

# The first line of a file as data for the log: printable characters only
# (log_* print with `echo -e`, so backslashes go too).
first_line(){ head -n 1 -- "$1" | tr -cd '[:print:]' | tr -d '\\'; }

export DEBIAN_FRONTEND=noninteractive
APT_OPTS=(-q -y -o Dpkg::Options::=--force-confnew)

TEGRA_RELEASE="$R/etc/nv_tegra_release"
if [[ ! -f "$TEGRA_RELEASE" ]]; then
    log_warn "нет /etc/nv_tegra_release — это не NVIDIA Jetson (L4T): TensorRT ставить неоткуда"
    exit 20
fi
log_info "L4T: $(first_line "$TEGRA_RELEASE")"

L4T_LIB="$R/opt/cream/ext/l4t/l4t.sh"
[[ -f "$L4T_LIB" ]] || { log_error "нет библиотеки l4t ($L4T_LIB) — cream ставит её по depends"; exit 1; }
# shellcheck source=/dev/null
source "$L4T_LIB"

# R32 BRANCH (Jetson Nano, JetPack 4.6): CHECK, DO NOT INSTALL.
#
# TensorRT 8.0.1.6 is already in the Q-engineering image (libnvinfer8, trtexec
# in libnvinfer-bin), and the NVIDIA repositories are disabled there — nothing
# to install from. The branch checks the engine and refuses when it is absent.
#
# NO PYTHON MODULE IS NOT A FAILURE. JetPack 4.6 publishes `tensorrt` only for
# Python 3.6 (bionic), the image has 3.8 (focal). Building the bindings is
# hours for a module nobody uses today; it is said aloud so that
# `import tensorrt` is not a surprise.
r32_verify(){
    local ver ldcache
    local trtexec="$R/usr/src/tensorrt/bin/trtexec"
    if ! is_installed libnvinfer8; then
        log_error "libnvinfer8 не установлен — ветка R32 ничего не ставит, движок обязан быть в базовом образе"
        return 1
    fi
    ver="$(dpkg-query -W -f='${Version}' libnvinfer8 2>/dev/null | tr -cd '[:alnum:].+~:-' || true)"
    if [[ ! -x "$trtexec" ]]; then
        log_error "нет /usr/src/tensorrt/bin/trtexec (пакет libnvinfer-bin)"
        return 1
    fi
    # Into a variable, not `ldconfig -p | grep -q`: pipefail and SIGPIPE.
    ldcache="$(ldconfig -p 2>/dev/null || true)"
    if ! grep -q "libnvinfer.so.8 " <<<"$ldcache"; then
        log_error "libnvinfer.so.8 не виден загрузчику"
        return 1
    fi
    # OPENBLAS_CORETYPE — so that numpy inside the module does not turn absence into a crash.
    if OPENBLAS_CORETYPE="$L4T_OPENBLAS_CORETYPE" python3 -c 'import tensorrt' >/dev/null 2>&1; then
        log_info "Python-модуль tensorrt есть"
    else
        log_warn "Python-модуля tensorrt нет: JetPack 4.6 публикует его только под Python 3.6; TensorRT доступен из C++ и trtexec"
    fi
    log_info "готово (R32): libnvinfer8 ${ver}, /usr/src/tensorrt/bin/trtexec, ничего не ставилось"
}

# String comparison: the major of an external file never goes to arithmetic.
if [[ "$(l4t_major || true)" == 32 ]]; then
    r32_verify || exit 1
    exit 0
fi

SOURCE_LIST="$R/etc/apt/sources.list.d/nvidia-l4t-apt-source.list"
if [[ ! -f "$SOURCE_LIST" ]]; then
    log_error "нет /etc/apt/sources.list.d/nvidia-l4t-apt-source.list — источник jetson/common не подключён"
    exit 1
fi

# WHY `nvidia-l4t-dla-compiler` TOO.
#
# Without it the Python binding — the main way on a Jetson — fails:
# `import tensorrt` dies with `ImportError: libnvdla_compiler.so`, and the
# same error breaks `jtop`, which reads the TensorRT version through ctypes.
# The C++ side works, so the image looks fine until the first run.
#
# HISTORY WORTH KNOWING. The package was added on 2026-09-12 and rolled back:
# the built image did not bring up the desktop. The diagnosis was WRONG — a
# race in cloud-user-desktop (the session took an incomplete group list
# without `video`) was to blame, and it was fixed there.
#
# Checked on a live board 2026-09-13: `apt-get install -s` installs exactly
# this package and upgrades nothing — nvidia-l4t-core and nvidia-l4t-3d-core
# stay 36.4.3. The package itself is published as 36.4.7 on a 36.4.3 stack
# and carries one file, libnvdla_compiler.so; if the GPU stack ever breaks,
# check this too.
PKGS=(tensorrt python3-libnvinfer nvidia-l4t-dla-compiler)
new=()
for p in "${PKGS[@]}"; do
    is_installed "$p" || new+=("$p")
done

log_info "apt-get update"
apt_retry apt-get update -q || exit 1

log_info "ставлю tensorrt, python3-libnvinfer и компилятор DLA"
apt_retry apt-get install "${APT_OPTS[@]}" "${PKGS[@]}" || {
    log_error "tensorrt не установился"
    exit 1
}

# What `remove` may take away: only what was not there before cream. A repeat
# (--reinstall) adds nothing and keeps the first record.
if (( ${#new[@]} )); then
    install -d -m 0755 "$STATE"
    { if [[ -f "$STATE/packages" && ! -L "$STATE/packages" ]]; then cat "$STATE/packages"; fi
      printf '%s\n' "${new[@]}"; } | sed '/^$/d' | sort -u | put_file 0644 "$STATE/packages"
fi

# LDCONFIG EXPLICITLY, NOT TRUSTING THE PACKAGE TRIGGER.
#
# libnvdla_compiler.so lands in /usr/lib/aarch64-linux-gnu/nvidia — the path
# is in /etc/ld.so.conf.d/nvidia-tegra.conf, but the cache is not rebuilt
# after the install. Measured on a live board: `ldconfig -p | grep -c nvdla`
# gave 1 before a manual ldconfig and 2 after — exactly the difference between
# a failing and a working `import tensorrt`.
ldconfig || log_warn "ldconfig отработал с ошибкой"

# Into a variable first: `ldconfig -p | grep -q` under pipefail fails on
# SIGPIPE and the check lies (the build of 2026-09-12 failed exactly so).
LDCACHE="$(ldconfig -p 2>/dev/null || true)"
if grep -q "libnvdla_compiler.so" <<<"$LDCACHE"; then
    log_info "libnvdla_compiler.so виден загрузчику"
else
    log_error "libnvdla_compiler.so не виден загрузчику — import tensorrt упадёт"
    exit 1
fi

log_info "готово: $(dpkg-query -W -f='${Version}' tensorrt 2>/dev/null | tr -cd '[:alnum:].+~:-' || echo '?')"

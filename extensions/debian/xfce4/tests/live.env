# Живой прогон tools/live-test.sh (make test-live EXT=xfce4): данные, не скрипт.
# live: confirm — ставится с --accept-risk; desktop (и его cloud-user) — раньше
# (depends). Сеть — apt дистрибутива (Xfce4, lightdm, Xorg — сотни мегабайт).
# Экрана в контейнере нет: lightdm на загрузке падает (нет VT и X); проверяются
# установка, drop-in lightdm, включённый менеджер входа и graphical.target,
# повтор, загрузка и remove. Совместно: lxde поверх — 67 (conflict.capability).
LIVE_DEPS="cloud-user desktop"
LIVE_ACCEPT_RISK=1
LIVE_MEMORY=2g
LIVE_DISTROS="debian-12"
# lightdm в контейнере падает (нет VT, X, logind) — не дефект расширения.
LIVE_FAILED_IGNORE='^lightdm\.service$'

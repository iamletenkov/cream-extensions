#!/usr/bin/env bash
# cream hook `remove` of xfce4: puts back what install changed and leaves the
# packages (Xfce4, lightdm, Xorg — other software may use them; take them away
# with apt by hand). From $CREAM_STATE_DIR/before: the default target goes back
# to what it was (multi-user.target when unknown), lightdm is disabled when it
# was not the display manager before; /etc/lightdm/lightdm.conf goes only when
# install created it. The drop-in of `files` is removed by cream itself. On a
# live machine a changed default target is exit 10 (reboot required).
set -euo pipefail

NAME=xfce4
DM=lightdm.service

log_info(){ >&2 echo "[INFO] $NAME: $*"; }
log_warn(){ >&2 echo "[WARN] $NAME: $*"; }

R="${CREAM_ROOT:-}"; R="${R%/}"
STATE="${CREAM_STATE_DIR:?run by cream}"
SYSD="$R/etc/systemd/system"
LCONF="$R/etc/lightdm/lightdm.conf"

if [[ ! -f "$STATE/before" ]]; then
    log_info "install не оставил записи — менять нечего"
    exit 0
fi

# before_value <key>: the value of key=… in the state file, as data (no eval).
before_value(){
    local line
    line="$(grep -m1 -E "^$1=" "$STATE/before")" || true
    printf '%s' "${line#*=}"
}
unit_re='^[A-Za-z0-9@._-]+\.(target|service)$'

dm_link="$(readlink "$SYSD/display-manager.service" 2>/dev/null)" || true
dm_before="$(before_value dm)"
if [[ -n "$dm_before" && ! "$dm_before" =~ $unit_re ]]; then
    log_warn "негодное значение dm в состоянии — менеджер входа не трогаю"
elif [[ "${dm_link##*/}" == "$DM" && "$dm_before" != "$DM" ]]; then
    systemctl disable "$DM" || log_warn "$DM не выключился"
fi

reboot=0
default_before="$(before_value default)"
if [[ ! "$default_before" =~ $unit_re ]]; then
    [[ -z "$default_before" ]] || log_warn "негодное значение default в состоянии — беру multi-user.target"
    default_before=multi-user.target
fi
if [[ "$(systemctl get-default 2>/dev/null || true)" != "$default_before" ]]; then
    systemctl set-default "$default_before" || log_warn "цель по умолчанию не вернулась к $default_before"
    reboot=1
fi

if [[ -f "$STATE/created-lightdm-conf" ]]; then
    if [[ -f "$LCONF" && ! -L "$LCONF" ]]; then
        rm -f -- "$LCONF"
        log_info "снят ${LCONF#"$R"}, созданный install"
    fi
    rm -f -- "$STATE/created-lightdm-conf"
fi
rm -f -- "$STATE/before"

log_info "готово; пакеты Xfce4 и lightdm остаются (apt-get remove — вручную)"
if [[ "$reboot" == 1 && "${CREAM_PHASE:-}" == live ]]; then
    exit 10
fi

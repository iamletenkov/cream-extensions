#!/usr/bin/env bash
# cream run firewall reload: apply rules.d now, synchronously, in one
# transaction (no window with open input). 1 — the files did not load and the
# fallback (loopback, replies, SSH) is in place; the reason is on stderr.
set -euo pipefail
exec "${CREAM_EXT_DIR:-$(dirname "$0")/..}/firewall.sh" apply

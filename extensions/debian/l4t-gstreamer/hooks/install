#!/usr/bin/env bash
# cream hook `install` of l4t-gstreamer: the NVIDIA hardware plugins plus the
# part of Ubuntu GStreamer a robot needs — cameras, RTSP, WebRTC, recording,
# Python.
#
# WHY AN EXTENSION WHEN HALF WAS ALREADY IN THE IMAGE. On the workstation image
# Ubuntu GStreamer arrived BY ACCIDENT — as dependencies of GNOME and dev
# packages. A headless robot would not get it, and "the robot has video" must
# not depend on what the desktop pulls. Measured on a board 2026-09-14: there
# was neither nvidia-l4t-gstreamer (no nvv4l2h264enc — the hardware encoder)
# nor gstreamer1.0-nice (webrtcbin registers but fails on the first
# connection — nothing to do ICE with).
#
# Checked on the same board after installing exactly this set:
#   videotestsrc 1080p        → nvvidconv → nvv4l2h264enc → mp4, 10 s
#   ximagesrc of the desktop  → nvvidconv → nvv4l2h264enc, 3840×2160
#   v4l2src of a Sensing cam  → nvvidconv → nvv4l2h265enc, 1920×1080
#
# Key (hook environment, scope install):
#   GSTREAMER_DEV   1 (default) — headers and .pc for building own GStreamer
#                   applications and the Jetson Multimedia API; 0 — without them
#
# Branch: l4t_major of the library l4t (/etc/nv_tegra_release read as data).
# Package versions from dpkg are external input: checked against the Debian
# version alphabet before they reach an apt argument or the log.
#
# Exit codes (spec §6.2, ruling R11): 20 — not a Jetson (no
# /etc/nv_tegra_release), before apt touches anything; 1 — failure; 0 — done.
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log_info(){ >&2 echo -e "${GREEN}[INFO]${NC} l4t-gstreamer: $*"; }
log_warn(){ >&2 echo -e "${YELLOW}[WARN]${NC} l4t-gstreamer: $*"; }
log_error(){ >&2 echo -e "${RED}[ERROR]${NC} l4t-gstreamer: $*"; }

R="${CREAM_ROOT:-}"; R="${R%/}"
STATE="${CREAM_STATE_DIR:?run by cream}"

# Local name on purpose: the default is never assigned to the exported key.
DEV="${GSTREAMER_DEV:-1}"
if [[ "$DEV" != 0 && "$DEV" != 1 ]]; then
    log_error "GSTREAMER_DEV: только 0 или 1"
    exit 1
fi

apt_retry(){
    local max=5 n=1 d
    while true; do
        if "$@"; then return 0; fi
        if (( n >= max )); then return 1; fi
        d=$(( n * 2 )); log_warn "apt не отработал, повтор через ${d}s ($n/$max)"
        sleep "$d"; n=$(( n + 1 ))
    done
}

# put_file MODE DEST: stdin into DEST through a temporary file in the same
# directory and a rename — a symlink at DEST is replaced, never followed.
put_file(){
    local mode="$1" dest="$2" tmp
    tmp="$(mktemp "$(dirname "$dest")/.l4t-gstreamer.XXXXXX")"
    cat > "$tmp"
    chmod "$mode" "$tmp"
    mv -f -T -- "$tmp" "$dest"
}

is_installed(){
    [[ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null || true)" == installed ]]
}

# pkg_version PKG: the installed version, empty when the package is absent or
# its version is not a Debian version (external input never goes further).
pkg_version(){
    local v
    v="$(dpkg-query -W -f='${Version}' "$1" 2>/dev/null || true)"
    [[ "$v" =~ ^[0-9][0-9A-Za-z.+~:-]*$ ]] || v=""
    printf '%s' "$v"
}

# The first line of a file as data for the log: printable characters only
# (log_* print with `echo -e`, so backslashes go too).
first_line(){ head -n 1 -- "$1" | tr -cd '[:print:]' | tr -d '\\'; }

export DEBIAN_FRONTEND=noninteractive
APT_OPTS=(-q -y -o Dpkg::Options::=--force-confnew)

TEGRA_RELEASE="$R/etc/nv_tegra_release"
if [[ ! -f "$TEGRA_RELEASE" ]]; then
    log_warn "нет /etc/nv_tegra_release — это не NVIDIA Jetson (L4T): плагины NVIDIA ставить неоткуда"
    exit 20
fi
log_info "L4T: $(first_line "$TEGRA_RELEASE")"

L4T_LIB="$R/opt/cream/ext/l4t/l4t.sh"
[[ -f "$L4T_LIB" ]] || { log_error "нет библиотеки l4t ($L4T_LIB) — cream ставит её по depends"; exit 1; }
# shellcheck source=/dev/null
source "$L4T_LIB"

GST_DIR="$R/usr/lib/aarch64-linux-gnu/gstreamer-1.0"

# R32 BRANCH (Jetson Nano, JetPack 4.6): CHECK, DO NOT INSTALL.
#
# The NVIDIA repositories in the Q-engineering image are disabled ("disabled on
# upgrade to focal") and built for bionic — enabling them on focal is wrong.
# The plugins are in the image and work (measured on a live Nano 2026-09-15:
# nvv4l2h264enc/h265enc, nvv4l2decoder, nvarguscamerasrc, package
# nvidia-l4t-gstreamer 32.6.1). So the branch checks what the extension exists
# for and refuses loudly when it is absent.
#
# The revision is compared up to the dash: R32 package suffixes are build
# dates, different within one stack (on a Nano core 32.6.1-20210726122000,
# gstreamer 32.6.1-20210916211029). String comparison, no arithmetic.
r32_verify(){
    local core gst missing=() so
    core="$(pkg_version nvidia-l4t-core)"
    gst="$(pkg_version nvidia-l4t-gstreamer)"
    if [[ -z "$core" || -z "$gst" ]]; then
        log_error "нет пакета nvidia-l4t-core или nvidia-l4t-gstreamer (core='$core', gstreamer='$gst')"
        log_error "ветка R32 ничего не ставит: плагины NVIDIA обязаны быть в базовом образе"
        return 1
    fi
    if [[ "${core%%-*}" != "${gst%%-*}" ]]; then
        log_error "nvidia-l4t-gstreamer $gst не той ревизии, что nvidia-l4t-core $core"
        return 1
    fi
    # By files, not gst-inspect-1.0 — the same reason as at the end of the R36 branch.
    for so in libgstnvvideo4linux2 libgstnvvidconv libgstnvarguscamerasrc; do
        [[ -f "$GST_DIR/$so.so" ]] || missing+=("$so")
    done
    if (( ${#missing[@]} )); then
        log_error "не хватает плагинов NVIDIA: ${missing[*]}"
        return 1
    fi
    # WebRTC does not connect without libnice; the Q-engineering image lacks it.
    # Not a refusal: nothing to install it from on R32, cameras and the encoder work.
    [[ -f "$GST_DIR/libgstnice.so" ]] || log_warn "нет libgstnice.so: webrtcbin не установит соединение (ICE)"
    log_info "готово (R32): nvidia-l4t-gstreamer $gst, плагины NVIDIA на месте, ничего не ставилось"
}

if [[ "$(l4t_major || true)" == 32 ]]; then
    r32_verify || exit 1
    exit 0
fi

# NVIDIA PLUGIN VERSION — BY THE STACK VERSION, NOT BY THE APT CANDIDATE.
#
# The r36.4 repository publishes updates in one branch: on 2026-09-14 the
# candidate of nvidia-l4t-gstreamer was 36.4.7 while the image stack was
# 36.4.3. The package dependencies are soft (`nvidia-l4t-multimedia
# (>= 36.3.0)`), so apt would happily put plugin 36.4.7 over libnvbufsurface
# 36.4.3 — and nothing notices until the ABI diverges. Take exactly the version
# of nvidia-l4t-core: the repository has it (measured: 36.4.0, 36.4.3, 36.4.4,
# 36.4.7). No such version — a refusal, never a fallback to the candidate.
L4T_VERSION="$(pkg_version nvidia-l4t-core)"
if [[ -z "$L4T_VERSION" ]]; then
    log_error "nvidia-l4t-core не установлен или его версия не разобрана — не с чем сверять версию плагинов"
    exit 1
fi
log_info "стек L4T: $L4T_VERSION"

log_info "apt-get update"
apt_retry apt-get update -q || exit 1

# The version list into a variable and grep on a herestring: `… | grep -q`
# under pipefail fails on SIGPIPE and the check lies.
AVAILABLE="$(apt-cache madison nvidia-l4t-gstreamer | awk '{print $3}')"
if ! grep -qxF "$L4T_VERSION" <<<"$AVAILABLE"; then
    log_error "в репозитории нет nvidia-l4t-gstreamer=$L4T_VERSION"
    log_error "есть: $(paste -sd' ' <<<"$AVAILABLE" | tr -cd '[:print:]' | tr -d '\\')"
    exit 1
fi

PKGS=(
    "nvidia-l4t-gstreamer=$L4T_VERSION"

    # Core and base plugins. gstreamer1.0-libav — software decoders (avdec_h264
    # etc.) for a stream the hardware decoder does not take.
    gstreamer1.0-tools
    gstreamer1.0-plugins-base
    gstreamer1.0-plugins-good
    gstreamer1.0-plugins-bad
    gstreamer1.0-plugins-ugly
    gstreamer1.0-libav

    # Display output and screen capture: ximagesrc (x), glimagesink (gl).
    gstreamer1.0-x
    gstreamer1.0-gl

    # Sound — for recording and WebRTC with a microphone.
    gstreamer1.0-alsa
    gstreamer1.0-pulseaudio

    # RTSP: the client (rtspsrc) is in good, the SERVER is a separate library —
    # the most common way to serve cameras from a robot.
    gstreamer1.0-rtsp
    libgstrtspserver-1.0-0
    gir1.2-gst-rtsp-server-1.0

    # WebRTC (webrtcbin in bad) does not connect without libnice: the element
    # registers, gst-inspect shows it, and it fails on ICE. Needed by Selkies
    # and any own WebRTC streamer.
    gstreamer1.0-nice

    # Python pipelines: Gst, GstWebRTC/GstSdp (plugins-bad), GstRtspServer.
    python3-gi
    python3-gst-1.0
    gir1.2-gstreamer-1.0
    gir1.2-gst-plugins-base-1.0
    gir1.2-gst-plugins-bad-1.0

    # v4l2-ctl: camera formats and controls; v4l2src debugging is blind without it.
    v4l-utils
)
if [[ "$DEV" == 1 ]]; then
    PKGS+=(
        libgstreamer1.0-dev
        libgstreamer-plugins-base1.0-dev
        libgstreamer-plugins-bad1.0-dev
        libgstrtspserver-1.0-dev
        # Jetson Multimedia API — headers and samples for the hardware codec
        # past GStreamer. Same version as the stack.
        "nvidia-l4t-jetson-multimedia-api=$L4T_VERSION"
    )
fi

new=()
for p in "${PKGS[@]}"; do
    is_installed "${p%%=*}" || new+=("${p%%=*}")
done

log_info "ставлю ${#PKGS[@]} пакетов (dev: $DEV)"
apt_retry apt-get install "${APT_OPTS[@]}" "${PKGS[@]}" || {
    log_error "установка не прошла"
    exit 1
}

# What `remove` may take away: only what was not there before cream. A repeat
# (--reinstall) adds nothing and keeps the first record.
if (( ${#new[@]} )); then
    install -d -m 0755 "$STATE"
    { if [[ -f "$STATE/packages" && ! -L "$STATE/packages" ]]; then cat "$STATE/packages"; fi
      printf '%s\n' "${new[@]}"; } | sed '/^$/d' | sort -u | put_file 0644 "$STATE/packages"
fi

# CHECK BY FILES, NOT gst-inspect-1.0.
#
# Inside virt-customize the guest is not booted: no /dev/nvhost-*, no
# /dev/v4l2-nvenc, and the NVIDIA plugins drop out of the registry scan for
# reasons a board will not have — gst-inspect would give a false refusal.
# Check that exactly the plugins this extension exists for are in place and
# that the stack version did not move.
missing=()
for so in libgstnvvideo4linux2 libgstnvvidconv libgstnvarguscamerasrc \
          libgstnvv4l2camerasrc libgstnvcompositor libgstnvjpeg \
          libgstnice libgstwebrtc libgstx264 libgstximagesrc libgstrtsp; do
    [[ -f "$GST_DIR/$so.so" ]] || missing+=("$so")
done
if (( ${#missing[@]} )); then
    log_error "не хватает плагинов: ${missing[*]}"
    exit 1
fi

AFTER="$(pkg_version nvidia-l4t-core)"
if [[ "$AFTER" != "$L4T_VERSION" ]]; then
    log_error "стек L4T сдвинулся при установке: $L4T_VERSION → ${AFTER:-?}"
    exit 1
fi

log_info "готово: nvidia-l4t-gstreamer $L4T_VERSION, GStreamer $(pkg_version libgstreamer1.0-0)"

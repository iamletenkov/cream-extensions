#!/usr/bin/env bash
# cream hook `install` of l4t-opencv: OpenCV for Jetson from the NVIDIA
# repository — cv2 4.8.0 with the GStreamer backend.
#
# WHY NVIDIA 4.8.0, NOT python3-opencv OF UBUNTU. Ubuntu has 4.5.4, and its
# Python module is not in the image (measured on a board 2026-09-14:
# libopencv-*4.5d came as dependencies of GStreamer dev, `import cv2` failed).
# NVIDIA builds 4.8.0 for L4T with GStreamer, FFmpeg and V4L2 — exactly what
# takes a camera frame through the hardware nvvidconv:
#
#   v4l2src ! video/x-raw,format=UYVY ! nvvidconv ! video/x-raw,format=BGRx
#     ! videoconvert ! video/x-raw,format=BGR ! appsink
#
# Checked on a board: 30 frames 1920×1080 from a Sensing camera in cv2.
#
# WHAT THIS BUILD LACKS — CUDA. No cv2.cuda. A CUDA build of OpenCV exists
# ready-made only in the jetson-ai-lab index, which does not serve files to the
# build network (measured 2026-09-14: every download breaks at 15 865 bytes at
# 25 B/s). Building from source is an hour or two per image. On a Jetson the
# GPU work rarely goes through cv2.cuda: nvvidconv converts the frame, the
# network is TensorRT or PyTorch.
#
# WHY ONLY RUNTIME AND PYTHON, NO libopencv-dev OF NVIDIA. It Conflicts with
# Ubuntu's libopencv-dev, and apt would take it away together with
# libgstreamer-plugins-bad1.0-dev depending on it (measured: the simulation
# removed 19 -dev packages). C++ headers stay Ubuntu's 4.5.4 (README).
#
# Branch: l4t_major of the library l4t (/etc/nv_tegra_release read as data).
#
# Exit codes (spec §6.2, ruling R11): 20 — not a Jetson (no
# /etc/nv_tegra_release), before apt touches anything; 1 — failure; 0 — done.
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log_info(){ >&2 echo -e "${GREEN}[INFO]${NC} l4t-opencv: $*"; }
log_warn(){ >&2 echo -e "${YELLOW}[WARN]${NC} l4t-opencv: $*"; }
log_error(){ >&2 echo -e "${RED}[ERROR]${NC} l4t-opencv: $*"; }

R="${CREAM_ROOT:-}"; R="${R%/}"
STATE="${CREAM_STATE_DIR:?run by cream}"

apt_retry(){
    local max=5 n=1 d
    while true; do
        if "$@"; then return 0; fi
        if (( n >= max )); then return 1; fi
        d=$(( n * 2 )); log_warn "apt не отработал, повтор через ${d}s ($n/$max)"
        sleep "$d"; n=$(( n + 1 ))
    done
}

# put_file MODE DEST: stdin into DEST through a temporary file in the same
# directory and a rename — a symlink at DEST is replaced, never followed.
put_file(){
    local mode="$1" dest="$2" tmp
    tmp="$(mktemp "$(dirname "$dest")/.l4t-opencv.XXXXXX")"
    cat > "$tmp"
    chmod "$mode" "$tmp"
    mv -f -T -- "$tmp" "$dest"
}

is_installed(){
    [[ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null || true)" == installed ]]
}

# The first line of a file or text as data for the log: printable characters
# only (log_* print with `echo -e`, so backslashes go too).
first_line(){ head -n 1 | tr -cd '[:print:]' | tr -d '\\'; }

export DEBIAN_FRONTEND=noninteractive
APT_OPTS=(-q -y -o Dpkg::Options::=--force-confnew)

TEGRA_RELEASE="$R/etc/nv_tegra_release"
if [[ ! -f "$TEGRA_RELEASE" ]]; then
    log_warn "нет /etc/nv_tegra_release — это не NVIDIA Jetson (L4T): OpenCV NVIDIA ставить неоткуда"
    exit 20
fi
log_info "L4T: $(first_line < "$TEGRA_RELEASE")"

L4T_LIB="$R/opt/cream/ext/l4t/l4t.sh"
[[ -f "$L4T_LIB" ]] || { log_error "нет библиотеки l4t ($L4T_LIB) — cream ставит её по depends"; exit 1; }
# shellcheck source=/dev/null
source "$L4T_LIB"

# R32 BRANCH (Jetson Nano, JetPack 4.6): CHECK AND PIN.
#
# OpenCV 4.8.0 is already built in the Q-engineering image — unlike R36 WITH
# CUDA 10.2 and GStreamer 1.16.3 (measured on a live Nano 2026-09-15). Nothing
# to install and nowhere from: the NVIDIA repositories are disabled. The branch
# checks that cv2 imports and is built with CUDA and GStreamer.
#
# One thing it does change: OPENBLAS_CORETYPE=ARMV8 (library l4t). Without it
# `import cv2` on Cortex-A57 dies with `Illegal instruction`, and the vendor
# image exported the variable from .bashrc of the removed `jetson` account.
r32_verify(){
    local info
    l4t_openblas_pin l4t-opencv || { log_error "OPENBLAS_CORETYPE не записан"; return 1; }
    install -d -m 0755 "$STATE"
    : | put_file 0644 "$STATE/openblas"
    # The import runs with the environment rebuilt from the written files, not an export.
    l4t_openblas_check 'import cv2; print("cv2", cv2.__version__)' || return 1
    info="$(env -i PATH="$PATH" OPENBLAS_CORETYPE="$L4T_OPENBLAS_CORETYPE" \
        python3 -c 'import cv2; print(cv2.getBuildInformation())' 2>&1)" || {
        log_error "cv2.getBuildInformation() не прошёл:"
        >&2 printf '%s\n' "$info"
        return 1
    }
    if ! grep -qE "^\s*NVIDIA CUDA:\s*YES" <<<"$info"; then
        log_error "cv2 собран без CUDA — это не образ Q-engineering с OpenCV под CUDA"
        return 1
    fi
    if ! grep -qE "^\s*GStreamer:\s*YES" <<<"$info"; then
        log_error "cv2 собран без GStreamer — кадры с камер через nvvidconv не взять"
        return 1
    fi
    log_info "готово (R32): cv2 с CUDA и GStreamer, ничего не ставилось"
}

# String comparison: the major of an external file never goes to arithmetic.
if [[ "$(l4t_major || true)" == 32 ]]; then
    r32_verify || exit 1
    exit 0
fi

# BOTH PACKAGES EXPLICITLY. NVIDIA's libopencv-python does not declare the
# dependency on its own libraries: apt installs cv2 alone, and the import fails
# with `libopencv_ml.so.408: cannot open shared object file` (measured).
PKGS=(libopencv libopencv-python)
new=()
for p in "${PKGS[@]}"; do
    is_installed "$p" || new+=("$p")
done

log_info "apt-get update"
apt_retry apt-get update -q || exit 1

log_info "ставлю libopencv и libopencv-python"
apt_retry apt-get install "${APT_OPTS[@]}" "${PKGS[@]}" || {
    log_error "установка не прошла"
    exit 1
}

# What `remove` may take away: only what was not there before cream. A repeat
# (--reinstall) adds nothing and keeps the first record.
if (( ${#new[@]} )); then
    install -d -m 0755 "$STATE"
    { if [[ -f "$STATE/packages" && ! -L "$STATE/packages" ]]; then cat "$STATE/packages"; fi
      printf '%s\n' "${new[@]}"; } | sed '/^$/d' | sort -u | put_file 0644 "$STATE/packages"
fi
ldconfig || log_warn "ldconfig отработал с ошибкой"

# The import works in the build chroot: cv2 touches no device on load.
BUILD_INFO="$(python3 -c 'import cv2; print(cv2.__version__); print(cv2.getBuildInformation())' 2>&1)" || {
    log_error "import cv2 не прошёл:"
    >&2 printf '%s\n' "$BUILD_INFO"
    exit 1
}
log_info "cv2 $(first_line <<<"$BUILD_INFO")"
if ! grep -qE "^\s*GStreamer:\s*YES" <<<"$BUILD_INFO"; then
    log_error "cv2 собран без GStreamer — кадры с камер через nvvidconv не взять"
    exit 1
fi
log_info "готово: GStreamer в cv2 есть, CUDA нет (см. шапку файла)"

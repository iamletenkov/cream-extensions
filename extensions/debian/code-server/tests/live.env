# Живой прогон tools/live-test.sh (make test-live EXT=code-server): данные, не скрипт.
# Сеть — .deb code-server с GitHub (~100 МБ) по sha256. Пароль — случайный секрет: его не
# должно быть в ps, журнале, реестре и config. В контейнере нет пользователя cloud-init
# (ни одной учётки uid ≥ 1000 с домашним каталогом): configure (стадия cloud-user) пишет
# предупреждение «нет пользователя» и выходит 0 (Р11) — сама служба в L не стартует.
LIVE_DEPS="cloud-user"
LIVE_MEMORY=2g
LIVE_SECRETS=CODE_SERVER_PASSWORD
LIVE_DISTROS="debian-12 ubuntu-24.04"

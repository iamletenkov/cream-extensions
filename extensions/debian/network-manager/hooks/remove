#!/usr/bin/env bash
# cream hook `remove` of network-manager: removes only the packages this
# extension's install put on ($CREAM_STATE_DIR/installed). Packages that were
# there before cream (the Raspberry Pi OS case) are left alone, and so is the
# network configuration: profiles belong to cloud-init and the operator.
# apt is asked first in simulation (library apt-guard): network-manager-gnome
# and with it a desktop metapackage depend on network-manager, and when apt
# would take anything besides our packages the hook refuses and changes nothing.
set -euo pipefail

log_info(){ >&2 echo "[INFO] network-manager: $*"; }
log_error(){ >&2 echo "[ERROR] network-manager: $*"; }

R="${CREAM_ROOT:-}"; R="${R%/}"
STATE="${CREAM_STATE_DIR:?run by cream}/installed"

if [[ ! -s "$STATE" ]]; then
    log_info "пакеты ставило не это расширение — не трогаю ничего"
    rm -f -- "$STATE"
    exit 0
fi

mapfile -t pkgs < <(sed '/^$/d' "$STATE")
export DEBIAN_FRONTEND=noninteractive
APT_GUARD="$R/opt/cream/ext/apt-guard/apt-guard.sh"
[[ -f "$APT_GUARD" ]] || { log_error "нет библиотеки apt-guard ($APT_GUARD) — cream ставит её по depends"; exit 1; }
# shellcheck source=../../apt-guard/apt-guard.sh
source "$APT_GUARD"
log_info "снимаю: ${pkgs[*]}"
apt_guard_remove remove "${pkgs[@]}" || exit 1
rm -f -- "$STATE"
log_info "готово"

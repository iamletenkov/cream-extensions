# Живой прогон tools/live-test.sh (make test-live EXT=chromium-kiosk): данные, не скрипт.
# live: confirm — ставится с --accept-risk. Сеть — apt дистрибутива и сторонний
# репозиторий repository.salamek.cz (ключ — files расширения). Экрана в
# контейнере нет: сессия пакета не поднимается; проверяются подключение
# репозитория по ключу из дерева, установка пакета, config.yml от configure на
# загрузке, повтор, --reinstall и remove.
LIVE_DEPS=apt-guard
LIVE_ACCEPT_RISK=1
LIVE_MEMORY=2g
LIVE_DISTROS="debian-12"

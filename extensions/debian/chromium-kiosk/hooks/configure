#!/usr/bin/env bash
# cream hook `configure` of chromium-kiosk: stage system, before the package's
# chromium-kiosk_configwatcher.service — every boot and after
# `cream set chromium-kiosk …` (no own apply: cream restarts configure; the
# config watcher of the package picks the new file up).
#
# Builds /etc/chromium-kiosk/config.yml (the package format) from the keys of
# the domain; the package keys that are not ours are constants below. Every
# value is checked by its form here once more (cream checks types on `set`,
# but the domain file can be edited by hand): a value out of form is a refusal
# (code 1, nothing written), not a guess. Strings go into YAML single-quoted,
# lists (separated by spaces) as flow sequences of quoted strings. The file is
# written through a temporary file and rename, only when it changes; a symlink
# in place of /etc/chromium-kiosk is refused.
set -euo pipefail
log_info(){ >&2 echo "[INFO] chromium-kiosk: $*"; }
log_error(){ >&2 echo "[ERROR] chromium-kiosk: $*"; }

R="${CREAM_ROOT:-}"; R="${R%/}"
DIR="$R/etc/chromium-kiosk"
TARGET="$DIR/config.yml"

URL_RE='^(https?|file)://[A-Za-z0-9._~:/?#@!&()*+,;=%-]+$'
GLOB_RE='^[A-Za-z0-9._~:/?#@!&()*+,;=%-]+$'
FLAG_RE='^--[a-z0-9][a-z0-9-]*(=[A-Za-z0-9._,:/=+-]*)?$'
BOOL_RE='^(true|false)$'
ROT_RE='^(normal|left|right|inverted)?$'
FEATURE_RE='^(desktop-audio-video-capture|desktop-video-capture|geolocation|invalid-certificate|media-audio-capture|media-audio-video-capture|media-video-capture|mouse-lock|notifications)$'

fail=0
# need KEY RE: the value of KEY (set by cream with the default) matches RE.
need(){
    local v="${!1-}"
    if [[ ! "$v" =~ $2 ]]; then
        log_error "$1 не по форме: $(printf '%q' "$v")"
        fail=1
    fi
}
# need_list KEY RE: every word of KEY matches RE; no other whitespace than spaces.
need_list(){
    local v="${!1-}" w
    if [[ "$v" == *[[:cntrl:]]* ]]; then
        log_error "$1: управляющие знаки в значении"; fail=1; return
    fi
    read -r -a words <<< "$v"
    for w in "${words[@]}"; do
        [[ "$w" =~ $2 ]] || { log_error "$1: элемент не по форме: $(printf '%q' "$w")"; fail=1; }
    done
}

need CHROMIUM_KIOSK_HOME_PAGE "$URL_RE"
need CHROMIUM_KIOSK_WINDOW_MODE '^(hidden|automaticvisibility|windowed|minimized|maximized|fullscreen)$'
need CHROMIUM_KIOSK_IDLE_TIME '^[0-9]{1,6}$'
for k in TOUCHSCREEN WHITE_LIST_ENABLED WHITE_LIST_IFRAME_ENABLED NAV_BAR_ENABLED \
         VIRTUAL_KEYBOARD_ENABLED CURSOR_ENABLED; do
    need "CHROMIUM_KIOSK_$k" "$BOOL_RE"
done
for k in DISPLAY_ROTATION SCREEN_ROTATION TOUCHSCREEN_ROTATION; do
    need "CHROMIUM_KIOSK_$k" "$ROT_RE"
done
need_list CHROMIUM_KIOSK_WHITE_LIST_URLS "$GLOB_RE"
need_list CHROMIUM_KIOSK_NAV_BAR_BUTTONS '^(home|reload|back|forward)$'
need_list CHROMIUM_KIOSK_EXTRA_ARGUMENTS "$FLAG_RE"
need_list CHROMIUM_KIOSK_ALLOWED_FEATURES "$FEATURE_RE"
if (( fail )); then
    log_error "/etc/chromium-kiosk/config.yml не записан: исправьте значения (cream set chromium-kiosk KEY=VALUE)"
    exit 1
fi

# YAML single-quoted scalar: the only escape is '' for ' (values are checked
# above and carry no quotes, the escape is the second line of defence).
yaml_str(){ local v="${1//\'/\'\'}"; printf "'%s'" "$v"; }
# Space-separated words -> YAML flow sequence of quoted strings.
yaml_list(){
    local out="" item
    local -a items=()
    read -r -a items <<< "$1"
    for item in "${items[@]}"; do out+="${out:+, }$(yaml_str "$item")"; done
    printf '[%s]' "$out"
}

rotation="$CHROMIUM_KIOSK_DISPLAY_ROTATION"
if [[ -z "$rotation" && -z "$CHROMIUM_KIOSK_SCREEN_ROTATION$CHROMIUM_KIOSK_TOUCHSCREEN_ROTATION" ]]; then
    rotation=normal
fi

content="$(
    echo "# Generated by the configure hook of chromium-kiosk (cream) from /etc/cream/chromium-kiosk/config."
    echo "# Do not edit: rewritten on every boot. Change: cream set chromium-kiosk KEY=VALUE"
    echo "WINDOW_MODE: $(yaml_str "$CHROMIUM_KIOSK_WINDOW_MODE")"
    echo "TOUCHSCREEN: $CHROMIUM_KIOSK_TOUCHSCREEN"
    echo "HOME_PAGE: $(yaml_str "$CHROMIUM_KIOSK_HOME_PAGE")"
    echo "IDLE_TIME: $CHROMIUM_KIOSK_IDLE_TIME"
    echo "WHITE_LIST:"
    echo "  ENABLED: $CHROMIUM_KIOSK_WHITE_LIST_ENABLED"
    echo "  URLS: $(yaml_list "$CHROMIUM_KIOSK_WHITE_LIST_URLS")"
    echo "  IFRAME_ENABLED: $CHROMIUM_KIOSK_WHITE_LIST_IFRAME_ENABLED"
    echo "NAV_BAR:"
    echo "  ENABLED: $CHROMIUM_KIOSK_NAV_BAR_ENABLED"
    echo "  ENABLED_BUTTONS: $(yaml_list "$CHROMIUM_KIOSK_NAV_BAR_BUTTONS")"
    echo "  HORIZONTAL_POSITION: 'center'"
    echo "  VERTICAL_POSITION: 'bottom'"
    echo "  WIDTH: 100"
    echo "  HEIGHT: 5"
    echo "  UNDERLAY: false"
    echo "VIRTUAL_KEYBOARD:"
    echo "  ENABLED: $CHROMIUM_KIOSK_VIRTUAL_KEYBOARD_ENABLED"
    if [[ -n "$rotation" ]]; then echo "DISPLAY_ROTATION: $(yaml_str "$rotation")"; fi
    if [[ -n "$CHROMIUM_KIOSK_SCREEN_ROTATION" ]]; then
        echo "SCREEN_ROTATION: $(yaml_str "$CHROMIUM_KIOSK_SCREEN_ROTATION")"
    fi
    if [[ -n "$CHROMIUM_KIOSK_TOUCHSCREEN_ROTATION" ]]; then
        echo "TOUCHSCREEN_ROTATION: $(yaml_str "$CHROMIUM_KIOSK_TOUCHSCREEN_ROTATION")"
    fi
    echo "EXTRA_ARGUMENTS: $(yaml_str "$CHROMIUM_KIOSK_EXTRA_ARGUMENTS")"
    # An explicit empty list, never a bare key: `ALLOWED_FEATURES:` is YAML
    # null, i.e. "no value", not "nothing allowed".
    echo "ALLOWED_FEATURES: $(yaml_list "$CHROMIUM_KIOSK_ALLOWED_FEATURES")"
    echo "CURSOR:"
    echo "  ENABLED: $CHROMIUM_KIOSK_CURSOR_ENABLED"
)"

if [[ -L "$DIR" ]]; then
    log_error "/etc/chromium-kiosk — символическая ссылка; через ссылку не пишу"
    exit 1
fi
if [[ -f "$TARGET" && ! -L "$TARGET" ]] && [[ "$(cat -- "$TARGET")" == "$content" ]]; then
    log_info "/etc/chromium-kiosk/config.yml уже такой — не переписываю"
    exit 0
fi
install -d -m 0755 "$DIR"
tmp="$(mktemp "$DIR/.config.yml.XXXXXX")"
printf '%s\n' "$content" > "$tmp"
chmod 0644 "$tmp"
mv -f -T -- "$tmp" "$TARGET"
log_info "/etc/chromium-kiosk/config.yml собран: страница $CHROMIUM_KIOSK_HOME_PAGE, поворот ${rotation:-—}"

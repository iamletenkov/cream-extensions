#!/usr/bin/env bash
# cream hook `install` of chromium-kiosk: the package chromium-kiosk from the
# Salamek repository. The repository file and its key are `files` (cream lays
# them out before this hook; the key is carried in the tree, pinned by its
# fingerprint), so nothing is downloaded here but the packages apt verifies.
# Only the missing packages; those put on here are recorded in
# $CREAM_STATE_DIR/packages (the first record wins) for `remove`.
#
# The system locale is NOT changed any more (layout 2 forced ru_RU.UTF-8):
# that is the job of the extension locale.
set -euo pipefail

GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; NC='\033[0m'
log_info(){ >&2 echo -e "${GREEN}[INFO]${NC} chromium-kiosk: $*"; }
log_warn(){ >&2 echo -e "${YELLOW}[WARN]${NC} chromium-kiosk: $*"; }
log_error(){ >&2 echo -e "${RED}[ERROR]${NC} chromium-kiosk: $*"; }

STATE="${CREAM_STATE_DIR:?run by cream}/packages"
PACKAGES=(ca-certificates chromium-kiosk)

apt_retry(){
    local max=5 n=1 d
    while true; do
        if "$@"; then return 0; fi
        if (( n >= max )); then return 1; fi
        d=$(( n * 2 )); log_warn "apt не отработал, повтор через ${d}s ($n/$max)"
        sleep "$d"; n=$(( n + 1 ))
    done
}
is_installed(){ [[ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null || true)" == installed ]]; }

missing=()
for pkg in "${PACKAGES[@]}"; do
    is_installed "$pkg" || missing+=("$pkg")
done
if (( ${#missing[@]} == 0 )); then
    log_info "chromium-kiosk уже установлен — apt не трогаю"
    exit 0
fi

export DEBIAN_FRONTEND=noninteractive
log_info "ставлю: ${missing[*]} (репозиторий repository.salamek.cz)"
apt_retry apt-get -q -y update || { log_error "apt-get update не прошёл"; exit 1; }
apt_retry apt-get -q -y -o Dpkg::Options::=--force-confold install "${missing[@]}" \
    || { log_error "apt-get install ${missing[*]} не прошёл"; exit 1; }
if [[ ! -s "$STATE" ]]; then
    install -d -m 0755 "$(dirname "$STATE")"
    printf '%s\n' "${missing[@]}" > "$STATE"
fi
log_info "chromium-kiosk установлен; /etc/chromium-kiosk/config.yml соберёт configure"

# Catalog pin of the stvor-agent package: the version and the sha256 of
# stvor-agent_<version>_<arch>.deb per architecture. Plain KEY=value lines,
# read by files/agent.sh without sourcing; tools/agent-bump.sh rewrites them
# from SHA256SUMS of a release. Explicit STVOR_AGENT_VERSION and
# STVOR_AGENT_SHA256 of `cream install` win over this pin.
STVOR_AGENT_PIN_VERSION=5.3.1
STVOR_AGENT_PIN_SHA256_AMD64=0589644b6f3d960158475ab35982e620b7496e74c2f1926138e8b9875342fdd5
STVOR_AGENT_PIN_SHA256_ARM64=439cfe607db4927cba3c8e29679daa923ac10cd8e40244fa486289a3b5dbae4d

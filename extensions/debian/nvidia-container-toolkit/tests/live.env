# Живой прогон tools/live-test.sh (make test-live EXT=nvidia-container-toolkit): данные, не скрипт.
# live: confirm — ставится с --accept-risk. Раньше ставятся cloud-user и docker
# (container-runtime) и nvidia (gpu-driver-nvidia): ядер и GPU в контейнере нет,
# nvidia возвращает 20, и её запись skipped — поставщик gpu-driver-nvidia
# (зависимость ставится с --allow-skip). Без драйвера тулкит всё равно ставится,
# runtime nvidia прописывается в /etc/docker/daemon.json, remove его снимает.
# NET_ADMIN — как у docker: без него dockerd в контейнере не стартует.
# Сеть — download.docker.com, nvidia.github.io.
LIVE_DEPS="cloud-user docker nvidia"
LIVE_ACCEPT_RISK=1
LIVE_CAPS=NET_ADMIN
LIVE_DISTROS="debian-12 ubuntu-24.04"

#!/usr/bin/env bash
# cream hook `install` of nvidia-container-toolkit: NVIDIA's apt repository
# with a pinned key, the toolkit (optionally of an exact version), and the
# `nvidia` runtime registered in /etc/docker/daemon.json WITHOUT touching
# default-runtime — containers stay on runc unless asked for `--runtime=nvidia`
# / `--gpus`.
#
# Keys (hook environment, scope install):
#   NVIDIA_CTK_VERSION   exact toolkit version (1.17.8 or 1.17.8-1);
#                        empty — the newest in the repository
#
# daemon.json is MERGED, never overwritten: `nvidia-ctk runtime configure`
# reads the file, adds runtimes.nvidia and keeps every other key. A file that
# already has the runtime is left alone (a repeat changes nothing, docker is
# not restarted). Before our first change the file is copied to
# $CREAM_STATE_DIR/daemon-json.before (or daemon-json.absent is noted), and the
# sha256 of our result to daemon-json.sha256: `remove` puts the file back only
# while it is still ours. A symlinked /etc/docker or daemon.json is refused —
# root does not write through links.
#
# Order of layers: Docker (container-runtime) is required and checked here.
# The driver (gpu-driver-nvidia) is required by the manifest, but its record
# may be `skipped` (no kernel/GPU — a container, a VM without passthrough):
# then libnvidia-ml.so.1 is absent, and that is a warning, not a refusal — the
# toolkit and the runtime entry do not need the GPU to be there.
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log_info(){ >&2 echo -e "${GREEN}[INFO]${NC} nvidia-container-toolkit: $*"; }
log_warn(){ >&2 echo -e "${YELLOW}[WARN]${NC} nvidia-container-toolkit: $*"; }
log_error(){ >&2 echo -e "${RED}[ERROR]${NC} nvidia-container-toolkit: $*"; }
die(){ log_error "$*"; exit 1; }

R="${CREAM_ROOT:-}"; R="${R%/}"
STATE="${CREAM_STATE_DIR:?run by cream}"
PHASE="${CREAM_PHASE:-live}"

apt_retry(){
    local max=5 n=1 d
    while true; do
        if "$@"; then return 0; fi
        if (( n >= max )); then return 1; fi
        d=$(( n * 2 )); log_warn "apt не отработал, повтор через ${d}s ($n/$max)"
        sleep "$d"; n=$(( n + 1 ))
    done
}

export DEBIAN_FRONTEND=noninteractive
APT_OPTS=(-q -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)

is_installed(){
    [[ "$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null || true)" == "install ok installed" ]]
}

# put_file MODE DEST: stdin into DEST through a temporary file in the same
# directory and a rename — a symlink at DEST is replaced, never followed.
put_file(){
    local mode="$1" dest="$2" tmp
    tmp="$(mktemp "$(dirname "$dest")/.nvidia-ctk.XXXXXX")"
    cat > "$tmp"
    chmod "$mode" "$tmp"
    mv -f -T -- "$tmp" "$dest"
}

CTK_VERSION="${NVIDIA_CTK_VERSION:-}"
if [[ -n "$CTK_VERSION" && ! "$CTK_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.~+]+)?$ ]]; then
    die "NVIDIA_CTK_VERSION=$CTK_VERSION: ожидается версия вида 1.17.8 или 1.17.8-1"
fi

# /etc/os-release is read as data, not sourced.
DISTRO_ID="$(sed -n 's/^ID=//p' "$R/etc/os-release" 2>/dev/null | head -n1 | tr -d '"')"
case "$DISTRO_ID" in
    debian|ubuntu) ;;
    *) die "расширение nvidia-container-toolkit рассчитано на debian и ubuntu, а здесь ID=$DISTRO_ID" ;;
esac
ARCH="$(dpkg --print-architecture)"
[[ "$ARCH" == amd64 ]] || die "расширение рассчитано на amd64 (как и nvidia), а машина — $ARCH"

# --- earlier layers -----------------------------------------------------------
[[ -x "$R/usr/bin/dockerd" || -x "$R/usr/sbin/dockerd" ]] \
    || die "Docker не установлен (нет dockerd): поставьте расширение docker раньше nvidia-container-toolkit"
if [[ ! -e "$R/usr/lib/x86_64-linux-gnu/libnvidia-ml.so.1" && ! -e "$R/usr/lib64/libnvidia-ml.so.1" ]]; then
    log_warn "драйвера NVIDIA нет (libnvidia-ml.so.1 не найдена; расширение nvidia пропущено — нет ядра или GPU?):"
    log_warn "тулкит и среда выполнения ставятся, но GPU в контейнерах не будет, пока драйвер не встанет"
fi

DOCKER_DIR="$R/etc/docker"
DAEMON_JSON="$DOCKER_DIR/daemon.json"
[[ ! -L "$DOCKER_DIR" ]] || die "$DOCKER_DIR — символическая ссылка: писать через неё не буду"
[[ ! -L "$DAEMON_JSON" ]] || die "$DAEMON_JSON — символическая ссылка: писать через неё не буду"

# --- repository ---------------------------------------------------------------
CTK_FPR=C95B321B61E88C1809C4F759DDCAE044F796ECB0
CTK_BASE=https://nvidia.github.io/libnvidia-container
KEYRING="$R/etc/apt/keyrings/nvidia-container-toolkit.asc"

# Another entry for the same URI with another Signed-By makes apt refuse the
# whole source list (lesson of the docker extension) — reuse an existing one.
if grep -rqsE "^[[:space:]]*deb[[:space:]].*nvidia\.github\.io/libnvidia-container" \
        "$R/etc/apt/sources.list" "$R/etc/apt/sources.list.d/" 2>/dev/null \
    || grep -rqsE "^[[:space:]]*URIs:.*nvidia\.github\.io/libnvidia-container" "$R/etc/apt/sources.list.d/" 2>/dev/null; then
    log_info "репозиторий libnvidia-container уже подключён — свой не добавляю"
else
    missing=()
    command -v curl >/dev/null 2>&1 || missing+=(curl)
    command -v gpg  >/dev/null 2>&1 || missing+=(gpg)
    # Without gpg-agent (gpg comes alone with --no-install-recommends) `gpg --import`
    # imports the key and still exits 2 ("failed to start agent") — measured in debian:12.
    command -v gpg-agent >/dev/null 2>&1 || missing+=(gpg-agent)
    [[ -e "$R/etc/ssl/certs/ca-certificates.crt" ]] || missing+=(ca-certificates)
    if (( ${#missing[@]} )); then
        apt_retry apt-get "${APT_OPTS[@]}" update
        apt_retry apt-get "${APT_OPTS[@]}" install --no-install-recommends "${missing[@]}"
    fi
    install -d -m 0755 "$R/etc/apt/keyrings" "$R/etc/apt/sources.list.d"
    # Trust exactly the pinned key: the file must hold ONE primary key with
    # the pinned fingerprint, and the keyring gets `gpg --export` of that key
    # from a throwaway GNUPGHOME, not the downloaded file — a second key in
    # the same file would otherwise become trusted by apt too.
    tmp="$(mktemp)"; out="$(mktemp)"; gh="$(mktemp -d)"
    ctk_clean(){ GNUPGHOME="$gh" gpgconf --kill all >/dev/null 2>&1 || true; rm -f "$tmp" "$out"; rm -r -f -- "$gh"; }
    curl -fsSL --retry 5 --retry-delay 2 "$CTK_BASE/gpgkey" -o "$tmp" \
        || { ctk_clean; die "ключ не скачался: $CTK_BASE/gpgkey"; }
    GNUPGHOME="$gh" gpg --batch --quiet --import "$tmp" >/dev/null 2>&1 \
        || { ctk_clean; die "ключ $CTK_BASE/gpgkey не импортируется gpg"; }
    pubs="$(GNUPGHOME="$gh" gpg --batch --with-colons --list-keys 2>/dev/null | awk -F: '$1=="pub"' | wc -l)"
    got="$(GNUPGHOME="$gh" gpg --batch --with-colons --list-keys 2>/dev/null \
        | awk -F: '$1=="pub" {p=1; next} p && $1=="fpr" {print $10; exit}')"
    [[ "$pubs" == 1 ]] \
        || { ctk_clean; die "в файле ключа $CTK_BASE/gpgkey — $pubs основных ключей, ожидался ровно один ($CTK_FPR)"; }
    [[ "$got" == "$CTK_FPR" ]] \
        || { ctk_clean; die "отпечаток ключа $CTK_BASE/gpgkey — [$got], ожидался [$CTK_FPR]"; }
    { GNUPGHOME="$gh" gpg --batch --armor --export "$CTK_FPR" > "$out" 2>/dev/null && [[ -s "$out" ]]; } \
        || { ctk_clean; die "не удалось экспортировать ключ $CTK_FPR"; }
    put_file 0644 "$KEYRING" < "$out"
    ctk_clean
    put_file 0644 "$R/etc/apt/sources.list.d/nvidia-container-toolkit.sources" <<EOF
Types: deb
URIs: $CTK_BASE/stable/deb/$ARCH/
Suites: /
Signed-By: /etc/apt/keyrings/nvidia-container-toolkit.asc
EOF
fi
apt_retry apt-get "${APT_OPTS[@]}" update

# --- packages -----------------------------------------------------------------
NAMES=(nvidia-container-toolkit nvidia-container-toolkit-base libnvidia-container-tools libnvidia-container1)
PKGS=("${NAMES[@]}")
if [[ -n "$CTK_VERSION" ]]; then
    avail="$(apt-cache madison nvidia-container-toolkit 2>/dev/null | awk -F'|' '{gsub(/ /,"",$2); print $2}')"
    full=""
    while read -r v; do
        if [[ "$v" == "$CTK_VERSION" || "$v" == "$CTK_VERSION"-* ]]; then full="$v"; break; fi
    done <<<"$avail"
    [[ -n "$full" ]] || die "nvidia-container-toolkit $CTK_VERSION нет в репозитории; есть: $(head -n5 <<<"$avail" | tr '\n' ' ')…"
    # All four are released in lockstep; pinning only the top one lets apt
    # pair it with a newer -base and fail on the exact dependency.
    PKGS=("${PKGS[@]/%/=$full}")
fi
fresh=()
for p in "${NAMES[@]}"; do
    is_installed "$p" || fresh+=("$p")
done
log_info "ставлю ${PKGS[*]}"
apt_retry apt-get "${APT_OPTS[@]}" install "${PKGS[@]}"

# Packages this hook put on (union with earlier installs): remove takes away
# only those. A record that is a symlink is not read — and is replaced.
install -d -m 0755 "$STATE"
ours=()
for p in "${fresh[@]}"; do
    is_installed "$p" && ours+=("$p")
done
if (( ${#ours[@]} )) || [[ -f "$STATE/packages" ]]; then
    {
        [[ -L "$STATE/packages" ]] || cat "$STATE/packages" 2>/dev/null || true
        printf '%s\n' "${ours[@]}"
    } | sed '/^$/d' | LC_ALL=C sort -u | put_file 0644 "$STATE/packages"
fi

# --- Docker runtime -----------------------------------------------------------
# No daemon.json and a daemon.json without the key are the same thing for
# dockerd — runc — so both read as "not set".
default_runtime(){
    [[ -f "$DAEMON_JSON" ]] || { echo "<не задан>"; return 0; }
    local v
    v="$(grep -oE '"default-runtime"[[:space:]]*:[[:space:]]*"[^"]*"' "$DAEMON_JSON" | sed -E 's/.*"([^"]*)"$/\1/' || true)"
    echo "${v:-<не задан>}"
}
has_runtime(){ [[ -f "$DAEMON_JSON" ]] && grep -qE '"nvidia"[[:space:]]*:' "$DAEMON_JSON"; }

if has_runtime; then
    log_info "runtime nvidia уже есть в $DAEMON_JSON — файл не трогаю"
else
    # The state before our first change, for remove.
    if [[ ! -e "$STATE/daemon-json.before" && ! -e "$STATE/daemon-json.absent" ]]; then
        if [[ -f "$DAEMON_JSON" ]]; then
            put_file 0600 "$STATE/daemon-json.before" < "$DAEMON_JSON"
        else
            : | put_file 0644 "$STATE/daemon-json.absent"
        fi
    fi
    before="$(default_runtime)"
    install -d -m 0755 "$DOCKER_DIR"
    # Merges into the file; no --set-as-default, on purpose. dockerd is not
    # running during the build and picks the runtime up on its first start.
    nvidia-ctk runtime configure --runtime=docker --config="$DAEMON_JSON"
    [[ ! -L "$DAEMON_JSON" ]] || die "$DAEMON_JSON стал символической ссылкой"
    after="$(default_runtime)"
    has_runtime || die "nvidia-ctk не добавил runtime nvidia в $DAEMON_JSON"
    [[ "$before" == "$after" ]] || die "default-runtime изменился: было [$before], стало [$after]"
    sha256sum < "$DAEMON_JSON" | cut -d' ' -f1 | put_file 0644 "$STATE/daemon-json.sha256"
    log_info "runtime nvidia дописан в $DAEMON_JSON; default-runtime: $after"
    # A running dockerd reads daemon.json only on start. try-restart: a
    # stopped docker stays stopped.
    if [[ "$PHASE" == live ]]; then
        systemctl try-restart docker.service || log_warn "перезапуск docker не прошёл — runtime nvidia появится после него"
    fi
fi
log_info "nvidia-container-toolkit $(dpkg-query -W -f='${Version}' nvidia-container-toolkit 2>/dev/null || true) установлен"

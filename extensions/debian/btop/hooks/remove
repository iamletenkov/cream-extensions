#!/usr/bin/env bash
# cream hook `remove` of btop: takes away what `install` put on, by the record
# in $CREAM_STATE_DIR/method — the apt package it installed, or the static
# /usr/local/bin/btop. A package that was there before cream stays. Without a
# record there is nothing of ours: 0. apt is asked first in simulation (library
# apt-guard): when it would take anything besides btop the hook refuses.
set -euo pipefail

log_info(){ >&2 echo "[INFO] btop: $*"; }
log_error(){ >&2 echo "[ERROR] btop: $*"; }

R="${CREAM_ROOT:-}"; R="${R%/}"
STATE="${CREAM_STATE_DIR:?run by cream}/method"
method="$(cat "$STATE" 2>/dev/null || true)"

case "$method" in
    apt)
        export DEBIAN_FRONTEND=noninteractive
        APT_GUARD="$R/opt/cream/ext/apt-guard/apt-guard.sh"
        [[ -f "$APT_GUARD" ]] || { log_error "нет библиотеки apt-guard ($APT_GUARD) — cream ставит её по depends"; exit 1; }
        # shellcheck source=../../apt-guard/apt-guard.sh
        source "$APT_GUARD"
        apt_guard_remove remove btop || exit 1
        log_info "пакет btop удалён"
        ;;
    static)
        rm -f -- "$R/usr/local/bin/btop"
        log_info "/usr/local/bin/btop удалён"
        ;;
    preexisting)
        log_info "пакет btop стоял до cream — оставлен"
        ;;
    *)
        log_info "записи об установке нет — удалять нечего"
        ;;
esac
rm -f -- "$STATE"

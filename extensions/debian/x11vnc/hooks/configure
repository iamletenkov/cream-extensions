#!/usr/bin/env bash
# cream hook `configure` of x11vnc: stage graphical, after the display manager —
# every boot, after install on a working machine. The password file (or the
# no-password marker) and x11vnc@<session user>.service: files/x11vnc.sh.
set -euo pipefail
exec "${CREAM_EXT_DIR:?run by cream}/files/x11vnc.sh" configure

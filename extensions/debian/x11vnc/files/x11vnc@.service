[Unit]
Description=x11vnc VNC server for user %i
After=graphical.target display-manager.service
Requires=display-manager.service

[Service]
Type=simple
User=%i
# Non-secret settings of the domain x11vnc (cream set x11vnc …); the dash: no
# file is not an error, the defaults live in the wrapper. The secrets file is
# NOT read: the password never enters the server's environment — the wrapper
# takes the derived /etc/x11vnc/passwd built by configure.
EnvironmentFile=-/etc/cream/x11vnc/config
# The display and the X authority are found at runtime by the wrapper
# (X11VNC_DISPLAY auto: lib/x-session.sh, files/x-session.sh); until the
# user's X session is there it waits, a line in the journal every 5 minutes.
ExecStart=/bin/bash /opt/cream/ext/x11vnc/files/run-x11vnc.sh %i
# Always: x11vnc ends with its X session (no -loop), and the next start finds
# the new session — after a logout and login it may be on another display.
Restart=always
RestartSec=5
# 78 (EX_CONFIG) — a setting to fix, a restart would not change it: the session
# is on Wayland; a uid outside 1000..65533 (root, a system account) or an
# X11VNC_DISPLAY that is neither auto nor :N; no password beyond the loopback.
RestartPreventExitStatus=78

[Install]
WantedBy=graphical.target

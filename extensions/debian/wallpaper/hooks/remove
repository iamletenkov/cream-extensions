#!/usr/bin/env bash
# cream hook `remove` of wallpaper: restores managed personal wallpaper first,
# then removes our system layers and restores pcmanfm.conf. Requires logout
# when personal settings were managed. A repeat finds nothing and exits 0.
set -euo pipefail
exec "${CREAM_EXT_DIR:?run by cream}/files/wallpaper.sh" remove

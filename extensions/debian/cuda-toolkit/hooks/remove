#!/usr/bin/env bash
# cream hook `remove` of cuda-toolkit: the packages `install` put on (the record
# in $CREAM_STATE_DIR/packages; a toolkit that was there before cream stays) and
# the profile /etc/profile.d/cuda-toolkit.sh; on R32 also the jetson/common
# source and key it added (record `source`) and the link /usr/local/cuda it
# made (record `link`). apt is asked first in simulation:
# when it would take away anything besides our packages (something installed
# later depends on them) the hook refuses and changes nothing. A repeat finds
# nothing and exits 0.
set -euo pipefail

log_info(){ >&2 echo "[INFO] cuda-toolkit: $*"; }
log_error(){ >&2 echo "[ERROR] cuda-toolkit: $*"; }

R="${CREAM_ROOT:-}"; R="${R%/}"
STATE="${CREAM_STATE_DIR:?run by cream}"

export DEBIAN_FRONTEND=noninteractive
ours=()
if [[ -f "$STATE/packages" && ! -L "$STATE/packages" ]]; then
    mapfile -t ours < <(sed '/^$/d' "$STATE/packages")
fi
if (( ${#ours[@]} )); then
    APT_GUARD="$R/opt/cream/ext/apt-guard/apt-guard.sh"
    [[ -f "$APT_GUARD" ]] || { log_error "нет библиотеки apt-guard ($APT_GUARD) — cream ставит её по depends"; exit 1; }
    # shellcheck source=../../apt-guard/apt-guard.sh
    source "$APT_GUARD"
    apt_guard_check remove "${ours[@]}" || exit 1
    apt-get -q -y remove "${ours[@]}" || { log_error "apt-get remove ${ours[*]} не прошёл"; exit 1; }
    log_info "удалены: ${ours[*]}"
else
    log_info "своих пакетов нет — CUDA не трогаю"
fi

if [[ -f "$STATE/source" && ! -L "$STATE/source" ]]; then
    rm -f -- "$R/etc/apt/sources.list.d/cream-cuda-toolkit.list" \
        "$R/usr/share/keyrings/cream-cuda-toolkit-jetson.asc"
    log_info "источник jetson/common и ключ NVIDIA сняты"
fi
# Only the link this extension made, and only while it still points where it did.
if [[ -f "$STATE/link" && ! -L "$STATE/link" && -L "$R/usr/local/cuda" \
      && "$(readlink -- "$R/usr/local/cuda")" == cuda-10.2 ]]; then
    rm -f -- "$R/usr/local/cuda"
fi

rm -f -- "$R/etc/profile.d/cuda-toolkit.sh" "$STATE/packages" "$STATE/source" "$STATE/link"

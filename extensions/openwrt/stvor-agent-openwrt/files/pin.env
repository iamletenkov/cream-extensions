# Catalog pin of the OpenWrt delivery of stvor-agent: the version and the sha256
# of stvor-agent_<version>_linux_<arch>.tar.gz per architecture. Plain KEY=value
# lines, read by files/agent.sh without sourcing; tools/agent-bump.sh rewrites
# them from SHA256SUMS of a release (the same file as the .deb pin of
# debian/stvor-agent). An empty pin (no release with the tar.gz yet) makes
# `cream install` need an explicit STVOR_AGENT_VERSION and STVOR_AGENT_SHA256
# (the install script of Stvor always passes them).
STVOR_AGENT_PIN_VERSION=4.1.0
STVOR_AGENT_PIN_SHA256_AMD64=9dee9d3bcc7cd5da8d759950e583b347d3d895807ebad4d9921495e0db25e74b
STVOR_AGENT_PIN_SHA256_ARM64=49ca33518cdf10d06e09783c8d559f08ca39616f00bab600761ee62080bfb1a9

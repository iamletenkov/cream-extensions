#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034  # USE_PROCD, START, STOP are read by /etc/rc.common
# procd service of the cream extension teleport-openwrt (spec 2026-10-20-openwrt §3, §4.2).
#
# Instance `teleport` — the node, when it is enabled (the state file agent-enabled,
# written by a confirmed join) or started now (/var/run/teleport.start, by join and
# its retry): render first (as ExecStartPre on Debian), then the agent with respawn.
# NO procd_set_param stdout/stderr: procd would set LD_PRELOAD=/lib/libsetlbf.so
# (musl) and a glibc process would load two libc; the journal of the node is
# log.output: syslog of teleport.yaml (logread -e teleport). TMPDIR is on the disk:
# /tmp is RAM.
#
# Instance `join` — the retry of a waiting join: while the state file join-pending
# exists, `cream run teleport-openwrt join-retry` at boot and every minute. It ends
# by itself when the marker is gone (registered or refused), so the retry that
# settles the join is never killed by its own service.
USE_PROCD=1
START=95
STOP=10

TP_STATE=/opt/cream/var/ext/teleport-openwrt
TP_HOME=/opt/teleport

start_service() {
	if [ -e "$TP_STATE/agent-enabled" ] || [ -e /var/run/teleport.start ]; then
		if /usr/bin/cream run teleport-openwrt render; then
			date +%s >/var/run/teleport.started
			procd_open_instance teleport
			procd_set_param command "$TP_HOME/bin/teleport" start --config /etc/teleport.yaml
			procd_set_param env TMPDIR="$TP_HOME/tmp"
			procd_set_param respawn 3600 5 0
			procd_set_param term_timeout 30
			procd_close_instance
		fi
	fi
	if [ -e "$TP_STATE/join-pending" ]; then
		procd_open_instance join
		# shellcheck disable=SC2016  # $1 is expanded by the inner sh
		procd_set_param command /bin/sh -c 'while [ -e "$1" ]; do /usr/bin/cream run --lock-timeout 6m teleport-openwrt join-retry; sleep 60; done' sh "$TP_STATE/join-pending"
		procd_close_instance
	fi
}

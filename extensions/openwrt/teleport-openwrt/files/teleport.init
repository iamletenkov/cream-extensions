#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034  # USE_PROCD, START, STOP are read by /etc/rc.common
# procd service of the cream extension teleport-openwrt (spec 2026-10-20-openwrt §3, §4.2).
#
# Instance `teleport` — the node, when it is enabled (the state file agent-enabled,
# written by a confirmed join) or started now (/var/run/teleport.start, by join and
# its retry): render first (as ExecStartPre on Debian), then the agent with respawn.
# NO procd_set_param stdout/stderr: procd would set LD_PRELOAD=/lib/libsetlbf.so
# (musl) and a glibc process would load two libc. The journal of the node is the
# file of log.output — /opt/teleport/log/teleport.log, directory 0700, file 0600
# (not syslog: any process logs any tag there, and join reads refusals from it).
# TMPDIR is on the disk: /tmp is RAM.
#
# Instance `logcap` — next to the agent: every 10 min (and before every start)
# `/etc/init.d/teleport log_cap` copies a log over 1 MiB to teleport.log.1 and
# truncates it in place — disk ≤ 2 MiB plus what is written in 10 min. Safe under
# a running agent: Teleport opens its log with O_APPEND (lib/utils/log,
# logFileDefaultFlag), so after the truncation it writes from the new end, with no
# sparse hole. The log stays on /opt: tmpfs is RAM on a 1 GB machine.
#
# Instance `join` — the retry of a waiting join: while the state file join-pending
# exists, `cream run teleport-openwrt join-retry` at boot and every minute. It ends
# by itself when the marker is gone (registered or refused), so the retry that
# settles the join is never killed by its own service.
USE_PROCD=1
START=95
STOP=10

TP_STATE=/opt/cream/var/ext/teleport-openwrt
TP_HOME=/opt/teleport
TP_LOG=$TP_HOME/log/teleport.log
TP_LOG_MAX=1048576
TP_LOG_PERIOD=600
EXTRA_COMMANDS="log_cap"
EXTRA_HELP="	log_cap	copy-truncate the log of the node over $TP_LOG_MAX bytes"

# log_cap: the root-only log (directory 0700, file 0600), over TP_LOG_MAX —
# copied to .1 and truncated in place (copy-truncate; the agent appends).
log_cap() {
	mkdir -p "${TP_LOG%/*}" && chmod 0700 "${TP_LOG%/*}" || return 1
	if [ -f "$TP_LOG" ] && [ ! -L "$TP_LOG" ] && [ "$(wc -c <"$TP_LOG")" -gt "$TP_LOG_MAX" ]; then
		cp -f "$TP_LOG" "$TP_LOG.1" && : >"$TP_LOG"
	fi
	[ -e "$TP_LOG" ] || : >"$TP_LOG"
	chmod 0600 "$TP_LOG" "$TP_LOG.1" 2>/dev/null
	return 0
}

start_service() {
	if [ -e "$TP_STATE/agent-enabled" ] || [ -e /var/run/teleport.start ]; then
		if log_cap && /usr/bin/cream run teleport-openwrt render; then
			date +%s >/var/run/teleport.started
			procd_open_instance teleport
			procd_set_param command "$TP_HOME/bin/teleport" start --config /etc/teleport.yaml
			procd_set_param env TMPDIR="$TP_HOME/tmp"
			procd_set_param respawn 3600 5 0
			procd_set_param term_timeout 30
			procd_close_instance
			procd_open_instance logcap
			procd_set_param command /bin/sh -c "while sleep $TP_LOG_PERIOD; do /etc/init.d/teleport log_cap; done"
			procd_set_param respawn 3600 5 0
			procd_close_instance
		fi
	fi
	if [ -e "$TP_STATE/join-pending" ]; then
		procd_open_instance join
		# shellcheck disable=SC2016  # $1 is expanded by the inner sh
		procd_set_param command /bin/sh -c 'while [ -e "$1" ]; do /usr/bin/cream run --lock-timeout 6m teleport-openwrt join-retry; sleep 60; done' sh "$TP_STATE/join-pending"
		procd_close_instance
	fi
}

# Pin of cosign used to sign the release SHA256SUMS (tools/release-sign.sh).
# Plain KEY=value lines, read without sourcing. The same version and sum as in
# the release workflow of the Teleport fork (one signing scheme for the
# stvor-platform key: the fork, stvor-agent, cream, cream-extensions).
#
# COSIGN_VERSION — tag of github.com/sigstore/cosign; COSIGN_SHA256_AMD64 —
# sha256 of the release asset cosign-linux-amd64 (the runners are amd64).
COSIGN_VERSION=v3.1.3
COSIGN_SHA256_AMD64=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71

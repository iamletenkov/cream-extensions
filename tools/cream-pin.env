# Pin of the cream executor used by tools/cream-validate.sh (`cream validate`
# over the cream/v1 extensions of this catalog). Plain KEY=value lines, read by
# the script without sourcing.
#
# CREAM_VERSION — release version without "v"; CREAM_SHA256 — sha256 of
# cream_<version>_amd64.deb from that release. Both empty means "no cream
# release yet": the check is skipped with a line, not failed. One of them
# without the other is an error.
# CREAM_URL (optional) — where to take the .deb; empty means the GitHub
# release asset of iamletenkov/cream.
CREAM_VERSION=
CREAM_SHA256=
CREAM_URL=
